# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploads
/uploads

# database
prisma/dev.db*
/dev.db*
prisma/migrations.sqlite.backup/
.env.backup-*

# PDFs de teste/demonstrativos gerados localmente
/demonstrativo-*.pdf
/fatura-*.pdf

# arquivos locais diversos
*.local
.migration-rge-to-uc.json
ocr-sample.json
uploads-zeroed-*.txt

# relatórios gerados (contém PII de clientes — não commitar em repo público)
/infosimples-report-*.md

# scripts temporários de diagnóstico/backfill (prefixo _). Os já versionados
# permanecem rastreados; isto só evita commitar novos descartáveis.
scripts/_*

# pasta aninhada acidental (cópia dentro do próprio projeto)
/controle-energia-solar/

# arquivos de trabalho / scratch locais
/temp/
/TODO_*.md
/unidades-consumidoras.xlsx

# script local de configuracao do Asaas — contem credencial, nao versionar
configurar-asaas.ps1
