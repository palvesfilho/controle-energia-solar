generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  // Vínculo com a identidade no Clerk. Nullable durante migração; após o
  // cutover do middleware deve ser preenchido pra todo user ativo.
  clerkId      String?  @unique @map("clerk_id")
  role         String   @default("INVESTOR") // ADMIN | GESTOR | FINANCEIRO | POS_VENDA | GESTOR_OBRA | INVESTOR | CONSUMER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  investor         Investor?
  uploads          Upload[]
  acoesResponsavel AcaoRecomendada[] @relation("AcaoResponsavel")
  acoesResolvidas  AcaoRecomendada[] @relation("AcaoResolvidaPor")

  @@map("users")
}

model Investor {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  phone              String?
  document           String? // Legacy - usar cpf/cnpj
  cpf                String?
  dataNascimento     DateTime? @map("data_nascimento")
  endereco           String?
  numero             String?
  complemento        String?
  cep                String?
  bairro             String?
  cidade             String?
  nomeEmpresa        String?   @map("nome_empresa")
  cnpj               String?
  enderecoEmpresa    String?   @map("endereco_empresa")
  numeroEmpresa      String?   @map("numero_empresa")
  complementoEmpresa String?   @map("complemento_empresa")
  cepEmpresa         String?   @map("cep_empresa")
  bairroEmpresa      String?   @map("bairro_empresa")
  cidadeEmpresa      String?   @map("cidade_empresa")
  chavePix           String?   @map("chave_pix")
  // Emails adicionais (sócios, financeiro etc.). JSON-encoded array de strings.
  additionalEmails   String?   @map("additional_emails")

  // Documentos da adesão, quando o investidor entrou por uma venda do CRM
  // marcada como `proprietario_usina`. Mesmos nomes de campo da ConsumerUnit
  // de propósito: a rotina de cópia ([[crm-copia-documentos]]) serve os dois
  // cadastros sem ter duas versões da mesma regra.
  //
  // Quem cede o telhado não é consumidor — não gera UC — mas a papelada dele
  // é a mesma e precisa ficar guardada aqui, não apontando para o CRM, que
  // apaga adesão.
  docTermoAdesao        String? @map("doc_termo_adesao")
  docTermoAdesaoNome    String? @map("doc_termo_adesao_nome")
  docProcuracao         String? @map("doc_procuracao")
  docProcuracaoNome     String? @map("doc_procuracao_nome")
  // Assinada no mesmo envelope do termo e da procuração desde 21/08/2026. Vazia
  // nas adesões anteriores: lá a autorização era pedida à parte, depois.
  docAutorizacaoAcesso     String? @map("doc_autorizacao_acesso")
  docAutorizacaoAcessoNome String? @map("doc_autorizacao_acesso_nome")
  docIdentidade         String? @map("doc_identidade")
  docIdentidadeNome     String? @map("doc_identidade_nome")
  docCartaoCnpj         String? @map("doc_cartao_cnpj")
  docCartaoCnpjNome     String? @map("doc_cartao_cnpj_nome")
  docContratoSocial     String? @map("doc_contrato_social")
  docContratoSocialNome String? @map("doc_contrato_social_nome")
  docOutros             String? @map("doc_outros")
  docOutrosNome         String? @map("doc_outros_nome")

  docsAdesaoIdCrm Int?      @map("docs_adesao_id_crm")
  docsCopiadosEm  DateTime? @map("docs_copiados_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants      InvestorPlant[]
  reports     MonthlyReport[]
  payables    InvestorPayable[]
  settlements InvestorSettlement[]
  debits      InvestorDebit[]

  @@map("investors")
}

model Plant {
  id                 String  @id @default(cuid())
  name               String
  location           String?
  potenciaModulos    Float?  @map("potencia_modulos")
  potenciaInversor   Float?  @map("potencia_inversor")
  geracaoMediaMensal Float?  @map("geracao_media_mensal")
  enquadramento      String?
  unidadeConsumidora String? @map("unidade_consumidora")
  // Código de instalação ANTERIOR à migração de códigos da RGE (jul/2026).
  unidadeConsumidoraAntiga String? @map("unidade_consumidora_antiga")
  concessionaria     String?
  formatoLeitura     String? @map("formato_leitura")
  regraInstalacao    String? @map("regra_instalacao") // USINA_DEDICADA | USINA_CONSUMO_PROPRIO | USINA_CONSUMO_DESCONTADO
  active             Boolean @default(true)

  // Dados do Inversor
  inversorMarca  String? @map("inversor_marca")
  inversorModelo String? @map("inversor_modelo")

  // Monitoramento
  monitoramentoPlataforma String? @map("monitoramento_plataforma")
  monitoramentoLogin      String? @map("monitoramento_login")
  monitoramentoSenha      String? @map("monitoramento_senha")
  monitoramentoUrl        String? @map("monitoramento_url")

  // Novos campos da planilha
  fonte                  String? // SOLAR, EOLICA, etc
  numeroUsina            String?   @map("numero_usina")
  potenciaInstalada      Float?    @map("potencia_instalada")
  grupo                  String? // A, B, etc
  cpfCnpj                String?   @map("cpf_cnpj")
  distribuidora          String? // RGE, CPFL_PAULISTA, CPFL_PIRATININGA
  acesso                 String? // Ok, Pendente, etc
  statusContrato         String?   @map("status_contrato")
  // Data em que o contrato com o investidor foi assinado (não necessariamente
  // quando a usina começou a injetar). Usada como início da janela de faturas
  // a descontar no primeiro relatório do investidor.
  dataAssinaturaContrato DateTime? @map("data_assinatura_contrato")
  loginDistribuidora     String?   @map("login_distribuidora")
  senhaDistribuidora     String?   @map("senha_distribuidora")
  codigoCliente          String?   @map("codigo_cliente") // Número de instalação/código do cliente no portal da distribuidora

  // Dia do mês em que o investidor desta usina recebe o repasse. Default 20 pra
  // todas; gestor pode ajustar por usina na tela de cadastro. Usado pela Agenda
  // da Semana pra gerar a task PAGAR_INVESTIDOR e EMITIR_RELATORIO_MENSAL
  // (esta última = pagamento - 3 dias).
  diaPagamentoInvestidor Int @default(20) @map("dia_pagamento_investidor")

  // Quem paga a fatura de energia da usina pra distribuidora:
  // - GESTORA: a gestora paga e depois cobra/desconta dos investidores (fluxo padrão)
  // - INVESTIDORES: cada investidor paga direto, gestora só acompanha pra controle
  // Afeta soma "a pagar" da agenda e badge na Gestão Financeira.
  pagadorFaturaEnergia String @default("GESTORA") @map("pagador_fatura_energia")

  // True quando a usina tem investidor vinculado e entra no fluxo da Gestora
  // de Energia (Clientes / Faturas / Faturamento). False = usina projetada
  // só pra cliente Rede Brasil Solar, fica oculta das listas da Gestora —
  // mas continua aparecendo nas telas /admin/brasil-solar.
  usinaDeInvestidor Boolean @default(false) @map("usina_de_investidor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  investors         InvestorPlant[]
  consumers         ConsumerPlant[]
  reports           MonthlyReport[]
  monthlyData       PlantMonthly[]
  consumerData      ConsumerMonthly[]
  consumerBills     ConsumerBill[]
  consumerUnits     ConsumerUnit[]
  billings          PlantBilling[]
  cpflCredential    CpflCredential?
  // 1:N — uma Plant pode ter várias usinas monitoradas (inversores) injetando
  // na mesma fatura da concessionária.
  monitoringClients BrasilSolarClient[] @relation("PlantMonitoring")
  rateioVersions    RateioVersion[]
  documents         PlantDocument[]
  investorPayables  InvestorPayable[]
  acoesRecomendadas AcaoRecomendada[]
  statusChanges     PlantStatusChange[]

  @@map("plants")
}

// Trilha de auditoria do liga/desliga da usina: uma linha por desativação E por
// reativação, com o motivo digitado pelo operador. Nome e e-mail são gravados
// como CÓPIA (não relação com User) pra o registro sobreviver a renomeação ou
// exclusão do usuário — auditoria não pode mudar de resposta depois.
model PlantStatusChange {
  id           String   @id @default(cuid())
  plantId      String   @map("plant_id")
  ativa        Boolean // estado que a usina passou a ter: true = reativada, false = desativada
  motivo       String
  usuarioId    String?  @map("usuario_id")
  usuarioNome  String   @map("usuario_nome")
  usuarioEmail String?  @map("usuario_email")
  createdAt    DateTime @default(now()) @map("created_at")

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, createdAt])
  @@map("plant_status_changes")
}

model PlantDocument {
  id           String   @id @default(cuid())
  plantId      String   @map("plant_id")
  type         String // CNH_RG | PROCURACAO | CONTRATO_SOCIAL | CARTAO_CNPJ
  url          String
  fileName     String   @map("file_name")
  size         Int?
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, type])
  @@index([plantId])
  @@map("plant_documents")
}

model PlantBilling {
  id      String @id @default(cuid())
  plantId String @map("plant_id")

  // Período de referência
  ano Int
  mes Int

  // Status do faturamento
  // PENDENTE → AGUARDANDO_DOCUMENTOS → AGUARDANDO_PAGAMENTO → PAGO
  status String @default("PENDENTE")

  // Valores
  valorTotal  Float?  @map("valor_total")
  observacoes String?

  // Relatório gerado pelo sistema (PDF / planilha)
  relatorioGeradoUrl String?   @map("relatorio_gerado_url")
  relatorioGeradoAt  DateTime? @map("relatorio_gerado_at")
  relatorioGeradoBy  String?   @map("relatorio_gerado_by")

  // Documentos enviados pelo dono da usina
  notaFiscalUrl    String?   @map("nota_fiscal_url")
  notaFiscalAt     DateTime? @map("nota_fiscal_at")
  reciboTerraUrl   String?   @map("recibo_terra_url")
  reciboTerraAt    DateTime? @map("recibo_terra_at")
  reciboAluguelUrl String?   @map("recibo_aluguel_url")
  reciboAluguelAt  DateTime? @map("recibo_aluguel_at")

  // Comprovante de pagamento (financeiro)
  comprovantePagamentoUrl String?   @map("comprovante_pagamento_url")
  comprovantePagamentoAt  DateTime? @map("comprovante_pagamento_at")
  comprovantePagamentoBy  String?   @map("comprovante_pagamento_by")

  // Encerramento do mes — setado quando o comprovante eh anexado OU
  // quando o operador formaliza "sem pagamento no mes" (semPagamentoMotivo).
  // Bloqueia todas as edicoes do mes (relatorio, payables, faturas, docs)
  // para roles != ADMIN. Apenas ADMIN reabre (limpa encerradoEm).
  encerradoEm        DateTime? @map("encerrado_em")
  encerradoPorUserId String?   @map("encerrado_por_user_id")

  // Motivo do encerramento "sem pagamento" (saldo negativo, sem geracao,
  // pausa contratual, outro). Quando preenchido, indica que o mes foi
  // encerrado sem comprovante de pagamento. Limpo no /reabrir.
  semPagamentoMotivo String? @map("sem_pagamento_motivo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, ano, mes])
  @@index([ano, mes])
  @@map("plant_billings")
}

model InvestorPlant {
  id                 String @id @default(cuid())
  investorId         String @map("investor_id")
  plantId            String @map("plant_id")
  sharePercent       Float? @map("share_percent")
  valorKwhContrato   Float? @map("valor_kwh_contrato") // R$/kWh pago ao investidor
  gestaoFixaContrato Float? @map("gestao_fixa_contrato") // R$ gestao fixa mensal

  // Regime "USINA DOMMO SOLUCOES": a gestora fica com 100% do lucro da operacao.
  // Quando true, `valorKwhContrato` e `gestaoFixaContrato` NAO se aplicam — a
  // remuneracao tem formula propria (kWh compensado no preco vigente menos o
  // desconto dado ao cliente). 🚧 Essa formula ainda NAO esta implementada: os
  // caminhos que gerariam dinheiro recusam em voz alta. Ver lib/usina-dommo.ts.
  isUsinaDommo Boolean @default(false) @map("is_usina_dommo")

  investor  Investor           @relation(fields: [investorId], references: [id], onDelete: Cascade)
  plant     Plant              @relation(fields: [plantId], references: [id], onDelete: Cascade)
  contracts InvestorContract[]

  @@unique([investorId, plantId])
  @@map("investor_plants")
}

// Contrato assinado entre Dommo Soluções (gestora) e o investidor (dono da
// usina). Cada InvestorPlant pode ter N contratos — original + aditivos —
// versionados por `versao`. O PDF fica no R2; valores monetários extraídos
// vão pros campos correspondentes em InvestorPlant (valorKwhContrato,
// gestaoFixaContrato). Aqui guardamos só o que não cabe lá: o arquivo,
// cláusulas de prazo/rescisão, e a versão.
model InvestorContract {
  id              String @id @default(cuid())
  investorPlantId String @map("investor_plant_id")

  // PDF arquivado no R2 (caminho relativo, via file-storage)
  url      String
  fileName String @map("file_name")
  size     Int?

  // Cláusulas extraídas do contrato
  dataAssinatura           DateTime? @map("data_assinatura")
  prazoMeses               Int?      @map("prazo_meses")
  marcoInicioPrazo         String?   @map("marco_inicio_prazo") // texto livre: "êxito do crédito", "data da assinatura", etc
  antecedenciaRescisaoDias Int?      @map("antecedencia_rescisao_dias")
  // Taxa inicial em múltiplos da geração mensal esperada (ex: 2 = 2× geração).
  // Paga pelos terceiros beneficiários, não pelo investidor diretamente.
  taxaInicialMultGeracao   Int?      @map("taxa_inicial_mult_geracao")
  foro                     String?
  observacoes              String?

  // Versionamento: 1 = original, 2+ = aditivos. `substituiId` aponta pro
  // contrato anterior quando este é um aditivo que o substitui.
  versao      Int     @default(1)
  substituiId String? @map("substitui_id")

  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  investorPlant InvestorPlant      @relation(fields: [investorPlantId], references: [id], onDelete: Cascade)
  substitui     InvestorContract?  @relation("ContratoAditivo", fields: [substituiId], references: [id], onDelete: SetNull)
  substituidos  InvestorContract[] @relation("ContratoAditivo")

  @@index([investorPlantId])
  @@map("investor_contracts")
}

model MonthlyReport {
  id              String  @id @default(cuid())
  plantId         String  @map("plant_id")
  investorId      String  @map("investor_id")
  ano             Int
  mes             Int
  numeroRelatorio String? @map("numero_relatorio")
  status          String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED

  // Resultado Energetico
  injecaoPeriodo     Float? @map("injecao_periodo")
  creditosAnteriores Float? @map("creditos_anteriores")
  creditosUtilizados Float? @map("creditos_utilizados")
  consumoInstantaneo Float? @map("consumo_instantaneo")
  autoConsumoUsina   Float? @map("auto_consumo_usina")
  creditosAtuais     Float? @map("creditos_atuais")
  creditosVencer     Float? @map("creditos_vencer")

  // Resultado Financeiro
  creditosUtilizadosFin Float? @map("creditos_utilizados_fin")
  valorKwhContrato      Float? @map("valor_kwh_contrato")
  valorBrutoGerador     Float? @map("valor_bruto_gerador")
  gestaoMensalFixa      Float? @map("gestao_mensal_fixa")
  taxaMinimaConc        Float? @map("taxa_minima_conc")
  inadimplencia         Float? @map("inadimplencia")
  multasOutros          Float? @map("multas_outros")
  remuneracaoPeriodo    Float? @map("remuneracao_periodo")

  // Observacoes
  observacoes String?

  // AI Analysis
  aiAnalysis         String? @map("ai_analysis")
  aiValidationStatus String? @map("ai_validation_status")

  // Snapshot completo dos dados consumidos pelo PDF — congelado no publish.
  // Estrutura segue InvestorReportData. Quando presente + status=PUBLISHED,
  // o PDF eh re-renderizado deste snapshot (imutavel mesmo se a base mudar).
  // Quando null, o gerador recalcula da base normalmente (DRAFT).
  snapshotJson String? @map("snapshot_json")

  // Metadata
  uploadId          String?   @map("upload_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  publishedAt       DateTime? @map("published_at")
  publishedByUserId String?   @map("published_by_user_id")

  plant    Plant    @relation(fields: [plantId], references: [id])
  investor Investor @relation(fields: [investorId], references: [id])
  upload   Upload?  @relation(fields: [uploadId], references: [id])

  @@unique([plantId, investorId, ano, mes])
  @@index([investorId, ano, mes])
  @@map("monthly_reports")
}

model PlantMonthly {
  id      String @id @default(cuid())
  plantId String @map("plant_id")
  ano     Int
  mes     Int

  geracaoTotal    Float?  @map("geracao_total") // kWh total gerado pela usina
  injecaoTotal    Float?  @map("injecao_total") // kWh injetado na rede
  autoConsumo     Float?  @map("auto_consumo") // kWh autoconsumo
  disponibilidade Float?  @map("disponibilidade") // % de disponibilidade
  observacoes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plant Plant @relation(fields: [plantId], references: [id])

  @@unique([plantId, ano, mes])
  @@map("plant_monthly")
}

model ConsumerMonthly {
  id         String @id @default(cuid())
  consumerId String @map("consumer_id")
  plantId    String @map("plant_id")
  ano        Int
  mes        Int

  consumoTotal       Float?  @map("consumo_total") // kWh consumo total do consumidor
  creditosRecebidos  Float?  @map("creditos_recebidos") // kWh creditos alocados
  creditosUtilizados Float?  @map("creditos_utilizados") // kWh creditos efetivamente usados
  saldoCreditos      Float?  @map("saldo_creditos") // kWh saldo de creditos
  economiaGerada     Float?  @map("economia_gerada") // R$ economia no periodo
  observacoes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumer Consumer @relation(fields: [consumerId], references: [id])
  plant    Plant    @relation(fields: [plantId], references: [id])

  @@unique([consumerId, plantId, ano, mes])
  @@map("consumer_monthly")
}

model Consumer {
  id                 String  @id @default(cuid())
  name               String
  email              String?
  phone              String?
  document           String? // CPF ou CNPJ
  endereco           String?
  unidadeConsumidora String? @map("unidade_consumidora")
  active             Boolean @default(true)

  // Novos campos da planilha
  cpfCnpj           String?   @map("cpf_cnpj")
  loginPortal       String?   @map("login_portal")
  emailsRecebimento String?   @map("emails_recebimento") // separados por ;
  dataCadastro      DateTime? @map("data_cadastro")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plants        ConsumerPlant[]
  monthly       ConsumerMonthly[]
  consumerUnits ConsumerUnit[]

  @@map("consumers")
}

model ConsumerUnit {
  id         String  @id @default(cuid())
  consumerId String? @map("consumer_id")
  plantId    String? @map("plant_id")

  // Origem do cadastro: define em qual contexto a UC vive.
  // PADRAO: fluxo investidor — aparece na gestão de UCs que recebem créditos.
  // BRASIL_SOLAR_TITULAR: UC do proprietário Brasil Solar (gera créditos).
  // BRASIL_SOLAR_BENEFICIARIA: UC que recebe créditos do proprietário BS.
  // Os dois últimos são ocultados por padrão da tela de gestão de UCs.
  origem String @default("PADRAO")

  // Identificação
  nome           String
  codigoUc       String  @unique @map("codigo_uc")
  // Código de instalação ANTERIOR à migração de códigos da RGE (jul/2026).
  // Preenchido pelo script importar-codigo-uc-rge quando o codigoUc é atualizado
  // para o novo número; preserva o histórico pra rastreabilidade/re-consulta.
  codigoUcAntigo String? @map("codigo_uc_antigo")
  cpfCnpj        String? @map("cpf_cnpj")

  // Distribuidora e classificação
  distribuidora String?
  grupo         String?
  subGrupo      String? @map("sub_grupo")
  modalidade    String? // AUTOCONSUMO_REMOTO, GERACAO_COMPARTILHADA, etc

  // Consumo
  consumoMedio Float? @map("consumo_medio")

  // Endereço
  cep         String?
  logradouro  String?
  complemento String?
  numero      String?
  cidade      String?

  // Comercial
  consultor         String?
  comissao          String?
  metodoPagamento   String? @map("metodo_pagamento")
  regraRemuneracao  String? @map("regra_remuneracao")
  percentCompensado Float?  @map("percent_compensado")
  percentBandeira   Float?  @map("percent_bandeira")
  regraVencimento   String? @map("regra_vencimento")
  valorVencimento   Float?  @map("valor_vencimento")

  // Contrato
  statusContrato      String?   @map("status_contrato")
  vigenciaCompensacao String?   @map("vigencia_compensacao")
  // Data de início do contrato — marco zero pra cálculo de economia/crédito
  // acumulado. Quando vazio, o sistema usa o mês mais antigo com fatura como
  // fallback.
  dataInicioContrato  DateTime? @map("data_inicio_contrato")

  // "Ok, pode cobrar" — o operador confirmando que viu a primeira compensação
  // desta UC e liberou o faturamento. NÃO é o status da UC: se ela compensa ou
  // não é derivado das faturas (ver lib/uc-implantacao.ts). Este campo guarda
  // só a decisão humana, pra o aviso da primeira compensação aparecer uma vez e
  // sumir depois de tratado — sem ele o sino repetiria as mesmas UCs pra sempre.
  cobrancaLiberadaEm  DateTime? @map("cobranca_liberada_em")
  cobrancaLiberadaPor String?   @map("cobranca_liberada_por")

  // Acesso à distribuidora
  loginDistribuidora String? @map("login_distribuidora")
  senhaDistribuidora String? @map("senha_distribuidora")

  // UC tem geração própria (placas solares no medidor). Lei 14.300: distribuidora
  // compensa primeiro a injeção própria; o restante consome créditos da usina do
  // rateio. Auto-marcado como true quando uma fatura chega com
  // energiaInjetadaMedidorKwh > 0.
  temGeracaoPropria Boolean @default(false) @map("tem_geracao_propria")

  // Grupo A — cadastro contratual da UC (coexiste com `modalidade` que é GD, não tarifária)
  modalidadeTarifaria      String? @map("modalidade_tarifaria") // "Verde"|"Azul"|"Convencional"|"Branca"
  tensaoNominalContratadaV Float?  @map("tensao_nominal_contratada_v")
  demandaContratadaKw      Float?  @map("demanda_contratada_kw") // Verde/Conv: única; Azul: FPonta
  demandaContratadaPontaKw Float?  @map("demanda_contratada_ponta_kw") // só Azul
  geracaoContratadaKw      Float?  @map("geracao_contratada_kw") // GD Grupo A (kW de geração contratada)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumer                 Consumer?                 @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  plant                    Plant?                    @relation(fields: [plantId], references: [id], onDelete: SetNull)
  billings                 ConsumerUnitBilling[]
  bills                    ConsumerBill[]
  cpflCredential           CpflCredential?
  rateioItems              RateioItem[]
  investorPayables         InvestorPayable[]
  acoesRecomendadas        AcaoRecomendada[]
  // Documentos da adesão, alojados AQUI e não apontando para o CRM.
  //
  // Motivo concreto: em 15/08/2026 a adesão 16 do INSTITUTO ELEVA foi apagada
  // do CRM enquanto a integração era construída. Documento que só referencia a
  // origem some junto com ela.
  //
  // O valor é o caminho relativo no storage (ver [[file-storage]]); o `*Nome`
  // guarda o nome original do arquivo, que é como o operador o reconhece.
  //
  // Quando o mesmo titular tem várias UCs (a LABIMED tem 11), o arquivo é
  // gravado UMA vez, com chave derivada da adesão de origem, e todas as UCs
  // apontam para ele. Campo por UC, objeto único no bucket.
  docTermoAdesao        String? @map("doc_termo_adesao")
  docTermoAdesaoNome    String? @map("doc_termo_adesao_nome")
  docProcuracao         String? @map("doc_procuracao")
  docProcuracaoNome     String? @map("doc_procuracao_nome")
  // Assinada no mesmo envelope do termo e da procuração desde 21/08/2026. Vazia
  // nas adesões anteriores: lá a autorização era pedida à parte, depois.
  docAutorizacaoAcesso     String? @map("doc_autorizacao_acesso")
  docAutorizacaoAcessoNome String? @map("doc_autorizacao_acesso_nome")
  docIdentidade         String? @map("doc_identidade")
  docIdentidadeNome     String? @map("doc_identidade_nome")
  docCartaoCnpj         String? @map("doc_cartao_cnpj")
  docCartaoCnpjNome     String? @map("doc_cartao_cnpj_nome")
  docContratoSocial     String? @map("doc_contrato_social")
  docContratoSocialNome String? @map("doc_contrato_social_nome")
  docOutros             String? @map("doc_outros")
  docOutrosNome         String? @map("doc_outros_nome")

  // Procedência: de qual adesão do CRM vieram, e quando. Sem isto, daqui a seis
  // meses ninguém sabe de onde o arquivo saiu.
  docsAdesaoIdCrm Int?      @map("docs_adesao_id_crm")
  docsCopiadosEm  DateTime? @map("docs_copiados_em")

  consumoBaselines         ConsumoBaseline[]
  brasilSolarBeneficiarias BrasilSolarBeneficiaria[]
  statusChanges            ConsumerUnitStatusChange[]

  @@index([consumerId])
  @@index([plantId])
  @@map("consumer_units")
}

// Gêmea de PlantStatusChange, para a UC. Mesmo formato de propósito: as duas
// telas usam o mesmo diálogo e a mesma leitura de auditoria.
model ConsumerUnitStatusChange {
  id             String   @id @default(cuid())
  consumerUnitId String   @map("consumer_unit_id")
  ativa          Boolean // estado que a UC passou a ter: true = reativada, false = desativada
  motivo         String
  usuarioId      String?  @map("usuario_id")
  usuarioNome    String   @map("usuario_nome")
  usuarioEmail   String?  @map("usuario_email")
  createdAt      DateTime @default(now()) @map("created_at")

  consumerUnit ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)

  @@index([consumerUnitId, createdAt])
  @@map("consumer_unit_status_changes")
}

model ConsumerUnitBilling {
  id             String @id @default(cuid())
  consumerUnitId String @map("consumer_unit_id")

  // Período de referência (mês da fatura de energia)
  ano Int
  mes Int

  // Valores apurados
  valorFatura     Float? @map("valor_fatura") // R$ total da fatura de energia
  valorCompensado Float? @map("valor_compensado") // R$ compensado pela usina
  valorEconomia   Float? @map("valor_economia") // R$ economia gerada
  valorCobranca   Float? @map("valor_cobranca") // R$ a cobrar do consumidor

  dataVencimento DateTime? @map("data_vencimento")
  observacoes    String?

  // Status: PENDENTE → ENVIADO_ASAAS → PARCIALMENTE_PAGO → PAGO | ATRASADO | CANCELADO
  // PARCIALMENTE_PAGO: cobrança parcelada com pelo menos 1 parcela paga, mas ainda há parcelas em aberto.
  status String @default("PENDENTE")

  // Parcelamento (uso esporádico): JSON array de até 10 parcelas, criadas como
  // cobranças Asaas independentes. null = cobrança única (fluxo padrão).
  // Estrutura: [{ dueDate: "YYYY-MM-DD", valor: number, asaasChargeId, asaasInvoiceUrl, asaasStatus, pagoEm: ISO|null }]
  installments String? @map("installments")

  // Fatura de energia anexada (PDF distribuidora)
  faturaUrl String?   @map("fatura_url")
  faturaAt  DateTime? @map("fatura_at")

  // Demonstrativo de cobrança (PDF gerado pelo sistema, anexado ao email do
  // cliente). Caminho no R2/storage; emitido junto com a cobrança Asaas.
  demonstrativoUrl         String?   @map("demonstrativo_url")
  demonstrativoGeradoEm    DateTime? @map("demonstrativo_gerado_em")
  // Validação do demonstrativo (FULL_ADMIN_TRIO) — só após validação o
  // botão "Realizar Cobrança" libera. Edição de valores reseta pra null.
  demonstrativoValidadoEm  DateTime? @map("demonstrativo_validado_em")
  demonstrativoValidadoPor String?   @map("demonstrativo_validado_por")

  // Envio do demonstrativo por email (Resend)
  emailEnviadoEm DateTime? @map("email_enviado_em")
  emailErro      String?   @map("email_erro")

  // Preferências de envio escolhidas pelo operador (persistidas mesmo sem disparar)
  notificarEmail    Boolean @default(true) @map("notificar_email")
  notificarWhatsapp Boolean @default(false) @map("notificar_whatsapp")

  // Integração Asaas
  asaasChargeId   String?   @map("asaas_charge_id")
  asaasInvoiceUrl String?   @map("asaas_invoice_url")
  asaasStatus     String?   @map("asaas_status")
  asaasSyncedAt   DateTime? @map("asaas_synced_at")

  // Pagamento confirmado
  pagoEm         DateTime? @map("pago_em")
  // Canal do pagamento — preenchido em pagamento manual (PIX direto, dinheiro, etc.)
  // ou marcado como BOLETO_ASAAS pelo webhook quando vem via Asaas.
  // Valores: PIX_DIRETO | DINHEIRO | TRANSFERENCIA | OUTRO | BOLETO_ASAAS
  formaPagamento String?   @map("forma_pagamento")
  pagamentoNota  String?   @map("pagamento_nota")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumerUnit     ConsumerUnit      @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  investorPayables InvestorPayable[]

  @@unique([consumerUnitId, ano, mes])
  @@index([ano, mes])
  @@map("consumer_unit_billings")
}

model ConsumerPlant {
  id              String @id @default(cuid())
  consumerId      String @map("consumer_id")
  plantId         String @map("plant_id")
  cotaPercent     Float? @map("cota_percent") // % dos creditos alocados ao consumidor
  descontoPercent Float? @map("desconto_percent") // % de desconto sobre a tarifa

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  plant    Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([consumerId, plantId])
  @@map("consumer_plants")
}

model ConsumerBill {
  id             String  @id @default(cuid())
  consumerUnitId String? @map("consumer_unit_id")
  plantId        String? @map("plant_id")

  // Referencia da fatura
  mesReferencia Int     @map("mes_referencia")
  anoReferencia Int     @map("ano_referencia")
  instalacao    String? // Numero da instalacao na concessionaria

  // Valores da fatura
  valorTotal          Float?    @map("valor_total")
  // Valor recalculado pelo nosso parser a partir dos itens da fatura — exclui
  // ajustes que não são do mês (juros/multa de débito antigo, refaturamento,
  // recuperação de consumo, etc.). É essa a base usada pra cobrar o cliente.
  // Mantém valorTotal original pra auditoria contra a fatura impressa.
  valorTotalCalculado Float?    @map("valor_total_calculado")
  vencimento          DateTime?
  contaPaga           Boolean   @default(false) @map("conta_paga")
  codigoBarras        String?   @map("codigo_barras")
  pixCopiaCola        String?   @map("pix_copia_cola")

  // Pagamento da fatura para a distribuidora (registrado pelo financeiro
  // via tela "Pagar Faturas"). Independe do contaPaga (que vem do parser).
  pagoEm                  DateTime? @map("pago_em")
  bancoPagamento          String?   @map("banco_pagamento") // BANRISUL | C6_BANK | ASAAS
  comprovantePagamentoUrl String?   @map("comprovante_pagamento_url")
  comprovantePagamentoAt  DateTime? @map("comprovante_pagamento_at")
  // Origem do registro: "BACKUP LUMI" para importações via CSV;
  // nome do usuário quando feito pela tela do sistema.
  origemPagamento         String?   @map("origem_pagamento")

  // Dados de consumo
  consumoKwh          Float?    @map("consumo_kwh")
  leituraAnterior     Float?    @map("leitura_anterior")
  leituraAtual        Float?    @map("leitura_atual")
  diasFaturamento     Int?      @map("dias_faturamento")
  proximaLeitura      DateTime? @map("proxima_leitura") // Próxima leitura — referência pra agendar sync
  // Janela do ciclo de leitura (não coincide com mês calendário). Usado pra validar inversor x medidor.
  dataLeituraAnterior DateTime? @map("data_leitura_anterior")
  dataLeituraAtual    DateTime? @map("data_leitura_atual")

  // Consumo faturado (mes atual) - TE e TUSD com quantidade e valor
  consumoTeKwh     Float? @map("consumo_te_kwh")
  consumoTeValor   Float? @map("consumo_te_valor")
  consumoTusdKwh   Float? @map("consumo_tusd_kwh")
  consumoTusdValor Float? @map("consumo_tusd_valor")

  // Creditos de energia (GD)
  energiaInjetada   Float? @map("energia_injetada")
  energiaCompensada Float? @map("energia_compensada")
  saldoCreditos     Float? @map("saldo_creditos")

  // Energia ativa injetada oUC (compensada no mes, total agregado)
  injetadaOucTeKwh     Float?  @map("injetada_ouc_te_kwh")
  injetadaOucTeValor   Float?  @map("injetada_ouc_te_valor")
  injetadaOucTusdKwh   Float?  @map("injetada_ouc_tusd_kwh")
  injetadaOucTusdValor Float?  @map("injetada_ouc_tusd_valor")
  // Detalhamento por mes de origem: [{ mesOrigem, teKwh, teValor, tusdKwh, tusdValor }]
  injetadaDetalhes     String? @map("injetada_detalhes")

  // Historico de consumo (13 meses) vindos da fatura: [{ mesAno, consumoKwh, dias }]
  historicoConsumo String? @map("historico_consumo")

  // Saldo de energia (GD) detalhado
  saldoInstalacaoKwh     Float? @map("saldo_instalacao_kwh")
  saldoExpirarProxMesKwh Float? @map("saldo_expirar_prox_mes_kwh")
  participacaoGeracaoPct Float? @map("participacao_geracao_pct")

  // Validação fatura × inversor: persiste resultado da última checagem feita
  // pelo operador no botão "Validar" da listagem de faturamentos. Sem isso,
  // o estado vivia só no React e exigia re-clicar a cada visita à tela.
  validacaoStatus  String?   @map("validacao_status") // OK | ALERTA | SEM_FATURA | SEM_INVERSOR
  validacaoDiffPct Float?    @map("validacao_diff_pct")
  validacaoEm      DateTime? @map("validacao_em")

  // Leitura física da injeção (fatura de usina) — grandeza "Energia Injetada" do medidor.
  // kWh injetado = (leituraAtual - leituraAnterior) * constante. Valida contra inversor.
  energiaInjetadaMedidorKwh Float? @map("energia_injetada_medidor_kwh")
  leituraInjetadaAnterior   Float? @map("leitura_injetada_anterior")
  leituraInjetadaAtual      Float? @map("leitura_injetada_atual")
  constanteMedidorInjetada  Float? @map("constante_medidor_injetada")

  // Grupo A: o medidor registra a injeção em DOIS postos, cada um com seu par de
  // leituras. `energiaInjetadaMedidorKwh` acima continua sendo o TOTAL (soma dos
  // postos) — é o que relatório e validação do inversor comparam com a geração —
  // mas o total sozinho APAGA a quebra, e o cliente Grupo A injeta nos dois.
  // Aqui cada posto fica inteiro: kWh e as leituras que o explicam.
  // Em fatura de posto único estes ficam nulos e valem os campos legados acima.
  energiaInjetadaMedidorPontaKwh     Float? @map("energia_injetada_medidor_ponta_kwh")
  leituraInjetadaPontaAnterior       Float? @map("leitura_injetada_ponta_anterior")
  leituraInjetadaPontaAtual          Float? @map("leitura_injetada_ponta_atual")
  energiaInjetadaMedidorForaPontaKwh Float? @map("energia_injetada_medidor_fora_ponta_kwh")
  leituraInjetadaForaPontaAnterior   Float? @map("leitura_injetada_fora_ponta_anterior")
  leituraInjetadaForaPontaAtual      Float? @map("leitura_injetada_fora_ponta_atual")

  // Custo de Disponibilidade (cobrança mínima B3 trifásico = 100 kWh). Separado do consumo real.
  custoDispTusdKwh   Float? @map("custo_disp_tusd_kwh")
  custoDispTusdValor Float? @map("custo_disp_tusd_valor")
  custoDispTeKwh     Float? @map("custo_disp_te_kwh")
  custoDispTeValor   Float? @map("custo_disp_te_valor")

  // ===== Grupo A — tarifa binômia + posto horário (P/FP) =====
  // Todos opcionais. Grupo B preenche null em tudo. Validado contra UC 4003710227 (OBA Verde-A4).

  // Consumo por posto
  consumoPontaKwh           Float? @map("consumo_ponta_kwh")
  consumoForaPontaKwh       Float? @map("consumo_fora_ponta_kwh")
  consumoTePontaKwh         Float? @map("consumo_te_ponta_kwh")
  consumoTePontaValor       Float? @map("consumo_te_ponta_valor")
  consumoTeForaPontaKwh     Float? @map("consumo_te_fora_ponta_kwh")
  consumoTeForaPontaValor   Float? @map("consumo_te_fora_ponta_valor")
  consumoTusdPontaKwh       Float? @map("consumo_tusd_ponta_kwh")
  consumoTusdPontaValor     Float? @map("consumo_tusd_ponta_valor")
  consumoTusdForaPontaKwh   Float? @map("consumo_tusd_fora_ponta_kwh")
  consumoTusdForaPontaValor Float? @map("consumo_tusd_fora_ponta_valor")

  // Tarifas por posto
  tarifaTePonta       Float? @map("tarifa_te_ponta")
  tarifaTeForaPonta   Float? @map("tarifa_te_fora_ponta")
  tarifaTusdPonta     Float? @map("tarifa_tusd_ponta")
  tarifaTusdForaPonta Float? @map("tarifa_tusd_fora_ponta")

  // Bandeira por posto
  bandeiraValorPonta            Float? @map("bandeira_valor_ponta")
  bandeiraValorForaPonta        Float? @map("bandeira_valor_fora_ponta")
  bandeiraCreditoPontaValor     Float? @map("bandeira_credito_ponta_valor")
  bandeiraCreditoForaPontaValor Float? @map("bandeira_credito_fora_ponta_valor")

  // Demanda (medida + ultrapassagem)
  demandaMedidaKw           Float? @map("demanda_medida_kw")
  demandaMedidaPontaKw      Float? @map("demanda_medida_ponta_kw") // só Azul
  demandaTusdValor          Float? @map("demanda_tusd_valor")
  tarifaDemanda             Float? @map("tarifa_demanda")
  demandaUltrapassagemKw    Float? @map("demanda_ultrapassagem_kw")
  demandaUltrapassagemValor Float? @map("demanda_ultrapassagem_valor")

  // TUSD-G (uso da rede pela geração — UC com mini/microGD em Grupo A)
  tusdGeracaoKw     Float? @map("tusd_geracao_kw")
  tusdGeracaoValor  Float? @map("tusd_geracao_valor")
  tarifaTusdGeracao Float? @map("tarifa_tusd_geracao")

  // Compensação Lei 14.300 por posto (TUSD+TE somados)
  injetadaPontaKwh       Float? @map("injetada_ponta_kwh")
  injetadaPontaValor     Float? @map("injetada_ponta_valor") // negativo (crédito)
  injetadaForaPontaKwh   Float? @map("injetada_fora_ponta_kwh")
  injetadaForaPontaValor Float? @map("injetada_fora_ponta_valor") // negativo (crédito)

  // Saldo de créditos por posto (Grupo A)
  saldoPontaKwh     Float? @map("saldo_ponta_kwh")
  saldoForaPontaKwh Float? @map("saldo_fora_ponta_kwh")

  // Reativo excedente
  reativoExcedentePontaKvar      Float? @map("reativo_excedente_ponta_kvar")
  reativoExcedentePontaValor     Float? @map("reativo_excedente_ponta_valor")
  reativoExcedenteForaPontaKvar  Float? @map("reativo_excedente_fora_ponta_kvar")
  reativoExcedenteForaPontaValor Float? @map("reativo_excedente_fora_ponta_valor")

  // Leituras múltiplas (8 grandezas: Ativa P/FP, Demanda P/FP, Reativa P/FP, Injetada P/FP)
  // JSON pra não inflar mais o schema. Estrutura: GrupoALeituraMedidor[] de fatura-pdf-parser-grupo-a.ts
  leiturasMedidorJson String? @map("leituras_medidor_json")

  // Energia injetada pelo painel solar DO PRÓPRIO CLIENTE (Lei 14.300).
  // Linhas "Energia Ativa Injetada TE/TUSD" da fatura RGE — SEM "oUC" no nome.
  // 100% do benefício é do cliente; NÃO entra no cálculo de cobrança da Associação.
  energiaInjetadaPropriaTeKwh     Float? @map("energia_injetada_propria_te_kwh")
  energiaInjetadaPropriaTeValor   Float? @map("energia_injetada_propria_te_valor")
  energiaInjetadaPropriaTusdKwh   Float? @map("energia_injetada_propria_tusd_kwh")
  energiaInjetadaPropriaTusdValor Float? @map("energia_injetada_propria_tusd_valor")

  // Tarifas
  tarifaTE                      Float?  @map("tarifa_te") // Tarifa Energia (ANEEL) — base sem impostos
  tarifaTUSD                    Float?  @map("tarifa_tusd") // Tarifa Uso Sistema Distribuicao — base sem impostos
  // Tarifa "com tributos" (ICMS+PIS+COFINS aplicados) — é o R$/kWh que o cliente
  // efetivamente paga. Usada no cálculo de cobrança da UC geradora DESCONTADO
  // (consumo instantâneo) para refletir o valor real economizado.
  tarifaTeComTributos           Float?  @map("tarifa_te_com_tributos")
  tarifaTusdComTributos         Float?  @map("tarifa_tusd_com_tributos")
  // Quando o operador digitou TE/TUSD a mao (tela "Manutencao da fatura"),
  // porque o OCR rotacionado corrompeu a tarifa. Marcado, o reparse do PDF
  // NAO sobrescreve mais esses dois campos: escolha explicita ganha de
  // deteccao. Ver lib/infosimples-pdf-fallback.ts e lib/preco-kwh.ts.
  tarifasManuaisEm              DateTime? @map("tarifas_manuais_em")
  bandeiraTarifaria             String? @map("bandeira_tarifaria")
  bandeiraValor                 Float?  @map("bandeira_valor") // Soma R$ de todas as linhas de bandeira da fatura
  // Adicional de Bandeira por cor — preenchido na linha "Adicional de Bandeira X".
  // Valor positivo (cobrança). Soma desses 3 = bandeiraValor (em Grupo B sem posto).
  bandeiraAmarelaValor          Float?  @map("bandeira_amarela_valor")
  bandeiraVermelhaValor         Float?  @map("bandeira_vermelha_valor")
  bandeiraVermelha2Valor        Float?  @map("bandeira_vermelha2_valor")
  // Crédito de Adicional de Bandeira por cor — preenchido na linha "Cred Adc Band X".
  // Valor NEGATIVO (vem com "-" na fatura, ex.: "4,34-"). Não entra na soma da fatura;
  // virará desconto pro cliente em etapa futura (mesma lógica do ajusteSaldoCredito).
  bandeiraAmarelaCreditoValor   Float?  @map("bandeira_amarela_credito_valor")
  bandeiraVermelhaCreditoValor  Float?  @map("bandeira_vermelha_credito_valor")
  bandeiraVermelha2CreditoValor Float?  @map("bandeira_vermelha2_credito_valor")

  // Consumo instantâneo: energia gerada pela usina e consumida na hora, sem
  // passar pela rede (não compensada). Só faz sentido para UC geradora em
  // USINA_CONSUMO_DESCONTADO — entra no cálculo de cobrança. Derivado de
  // `geracaoInversorKwh - energiaInjetadaMedidorKwh` quando ambos existem.
  consumoInstantaneoKwh Float? @map("consumo_instantaneo_kwh")

  // Geração total do inversor no período da fatura (kWh). Usada para derivar
  // consumo instantâneo em UC geradora DESCONTADO. Pode vir de:
  //  - AUTO: coleta via API do inversor (Fronius/Huawei/SolarEdge/Sungrow)
  //  - MANUAL: preenchido quando o inversor fica offline / sem dados
  geracaoInversorKwh    Float?  @map("geracao_inversor_kwh")
  geracaoInversorOrigem String? @map("geracao_inversor_origem") // "AUTO" | "MANUAL"

  // Impostos
  icms   Float?
  pis    Float?
  cofins Float?

  // Encargos e ajustes
  jurosMora            Float? @map("juros_mora")
  multaAtraso          Float? @map("multa_atraso")
  atualizacaoMonetaria Float? @map("atualizacao_monetaria")
  iluminacaoPublicaCip Float? @map("iluminacao_publica_cip")
  ajusteSaldoCredito   Float? @map("ajuste_saldo_credito")
  // Linha "Devol Pagamento Indevido" da seção CRÉDITOS / DEVOLUÇÕES da RGE/CPFL.
  // Gravada NEGATIVA, como vem impressa: a concessionária está devolvendo na
  // conta do mês um valor que JÁ FOI PAGO antes — e quem pagou, em fatura única,
  // foi a nossa empresa. Por isso ela volta a SOMAR no repasse cobrado do
  // cliente (ver lib/billing-calculator.ts). `valorTotal` continua sendo o
  // valor impresso (já líquido da devolução), pra auditoria contra a fatura.
  devolPagamentoIndevido Float? @map("devol_pagamento_indevido")

  // Metadados da sincronizacao
  fonteConsulta String?  @map("fonte_consulta") // "INFOSIMPLES" | "MANUAL" | "CPFL_PORTAL"
  pdfUrl        String?  @map("pdf_url")
  rawJson       String?  @map("raw_json") // Resposta completa da API
  syncedAt      DateTime @default(now()) @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumerUnit           ConsumerUnit?     @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  plant                  Plant?            @relation(fields: [plantId], references: [id])
  // Payables criados a partir desta fatura (lado do consumidor — quem teve a compensação)
  investorPayables       InvestorPayable[] @relation("PayablesFromConsumerBill")
  // Payables originados pela leitura desta fatura (lado da usina — quem injetou os créditos
  // que foram dispachados nessa janela). É a chave do "mês de geração" usado como
  // competência do relatório do investidor.
  payablesOriginatedHere InvestorPayable[] @relation("PayablesOriginatedByPlantBill")

  @@unique([consumerUnitId, anoReferencia, mesReferencia])
  @@index([consumerUnitId, anoReferencia])
  @@index([plantId, anoReferencia])
  @@map("consumer_bills")
}

model CpflCredential {
  id             String  @id @default(cuid())
  consumerUnitId String? @unique @map("consumer_unit_id")
  plantId        String? @unique @map("plant_id")

  emailCpfl     String @map("email_cpfl") // Login no portal CPFL
  senhaCpfl     String @map("senha_cpfl") // Senha no portal CPFL (criptografada)
  instalacao    String // Numero da instalacao
  // Derivada do cadastro (ConsumerUnit.distribuidora / Plant.concessionaria),
  // nunca escolhida a parte. Valores em src/lib/concessionarias.ts.
  distribuidora String @default("RGE/CPFL")

  // ultimaSync = último sync que deu CERTO. ultimaTentativaSync = última vez que
  // tentamos, dê certo ou não. Sem o segundo campo a tela mostrava o erro novo
  // com a data do último sucesso ("Erro no sync (29/05/2026)" para uma falha de
  // 27/07/2026) e parecia que ninguém mais havia tentado.
  ultimaSync          DateTime? @map("ultima_sync")
  ultimaTentativaSync DateTime? @map("ultima_tentativa_sync")
  statusSync          String?   @map("status_sync") // "SUCCESS" | "ERROR" | "PENDING"
  erroSync            String?   @map("erro_sync")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumerUnit ConsumerUnit? @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  plant        Plant?        @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("cpfl_credentials")
}

model Upload {
  id              String    @id @default(cuid())
  fileName        String    @map("file_name")
  fileSize        Int       @map("file_size")
  filePath        String    @map("file_path")
  mimeType        String    @map("mime_type")
  uploadedById    String    @map("uploaded_by_id")
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error")
  rawData         String?   @map("raw_data")

  createdAt DateTime @default(now()) @map("created_at")

  uploadedBy User            @relation(fields: [uploadedById], references: [id])
  reports    MonthlyReport[]

  @@map("uploads")
}

// ============================================================
// BRASIL SOLAR - Monitoramento de Clientes
// ============================================================

model BrasilSolarClient {
  id String @id @default(cuid())

  // Dados do cliente
  nome      String
  cpfCnpj   String? @map("cpf_cnpj")
  email     String?
  telefone  String?
  endereco  String?
  cidade    String?
  uf        String?
  bairro    String?
  cep       String?
  latitude  Float?
  longitude Float?

  // Dados da instalacao
  potenciaInstalada  Float?    @map("potencia_instalada") // kWp
  dataInstalacao     DateTime? @map("data_instalacao")
  modulosMarca       String?   @map("modulos_marca")
  modulosModelo      String?   @map("modulos_modelo")
  modulosQuantidade  Int?      @map("modulos_quantidade")
  inversorMarca      String?   @map("inversor_marca")
  inversorModelo     String?   @map("inversor_modelo")
  inversorQuantidade Int?      @map("inversor_quantidade")
  inversorPotencia   Float?    @map("inversor_potencia") // kW

  // Plataforma de monitoramento
  plataformaMonitoramento String? @map("plataforma_monitoramento") // GROWATT, SOLIS, FRONIUS, HUAWEI, CANADIAN, ABB, DEYE, HOYMILES, SUNGROW, SOFAR, SOLAREDGE
  monitoramentoLogin      String? @map("monitoramento_login")
  monitoramentoSenha      String? @map("monitoramento_senha")
  monitoramentoUrl        String? @map("monitoramento_url")
  monitoramentoPlantId    String? @map("monitoramento_plant_id")

  // Concessionaria
  concessionaria String?
  codigoUc       String? @map("codigo_uc")
  // Código de instalação ANTERIOR à migração de códigos da RGE (jul/2026).
  codigoUcAntigo String? @map("codigo_uc_antigo")

  // Contrato
  statusContrato String?   @map("status_contrato") // ATIVO, SUSPENSO, CANCELADO, GARANTIA
  dataContrato   DateTime? @map("data_contrato")
  consultor      String?
  garantiaAte    DateTime? @map("garantia_ate")

  // Financeiro
  investimento Float? // R$ valor total do investimento na usina

  // Geracao esperada (para calcular performance ratio)
  geracaoMediaEsperada Float? @map("geracao_media_esperada") // kWh/mes esperado
  geracaoAnualEsperada Float? @map("geracao_anual_esperada") // kWh/ano esperado
  geracaoContrato      Float? @map("geracao_contrato") // kWh conforme contrato

  // Status atual (desnormalizado para queries rapidas em 2700+ registros)
  statusMonitoramento String    @default("SEM_DADOS") @map("status_monitoramento") // ONLINE, OFFLINE, ALERTA, SEM_DADOS
  ultimaGeracao       Float?    @map("ultima_geracao") // kWh ultimo dia
  ultimaLeitura       DateTime? @map("ultima_leitura")
  geracaoMesAtual     Float?    @map("geracao_mes_atual") // kWh acumulado mes
  performanceRatio    Float?    @map("performance_ratio") // % real vs esperado

  // Métricas instantâneas coletadas pelo sync/metrics (Fase 2.1)
  tensaoRede          Float?    @map("tensao_rede") // V - tensão AC medida (fase mais alta quando trifásico)
  tensaoNominalRede   Float?    @map("tensao_nominal_rede") // V - nominal (127/220); inferida pela medida quando null
  frequenciaRede      Float?    @map("frequencia_rede") // Hz - frequência AC medida
  temperaturaInversor Float?    @map("temperatura_inversor") // °C - temperatura interna do inversor
  ultimaMetricaEm     DateTime? @map("ultima_metrica_em") // timestamp da última coleta de métricas instantâneas

  // Observacoes internas
  observacoesInternas String? @map("observacoes_internas")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacoes
  monitoringLogs     MonitoringLog[]
  alerts             MonitoringAlert[]
  inverterSamples    InverterSample[]
  monitoringPlans    BrasilSolarMonitoringPlan[]
  lancamentosManuais ManualGenerationEntry[]

  // Link opcional com dados existentes
  consumerId String? @map("consumer_id")
  // plantId: quando preenchido, associa esta usina monitorada à Plant (Gestor
  // de Créditos) que recebe sua geração. 1:N (uma Plant pode agregar várias
  // usinas monitoradas injetando na mesma fatura da concessionária).
  plantId    String? @map("plant_id")
  plant      Plant?  @relation("PlantMonitoring", fields: [plantId], references: [id], onDelete: SetNull)

  // Proprietario (dono da usina)
  proprietarioId String?                  @map("proprietario_id")
  proprietario   BrasilSolarProprietario? @relation(fields: [proprietarioId], references: [id], onDelete: SetNull)

  @@index([statusMonitoramento])
  @@index([cidade])
  @@index([uf])
  @@index([plataformaMonitoramento])
  @@index([statusContrato])
  @@index([nome])
  @@index([proprietarioId])
  @@index([plantId])
  @@map("brasil_solar_clients")
}

// Histórico de planos de monitoramento pago contratados por usina.
// Renovação cria um novo registro — não edita o anterior. Plano vigente é
// derivado: registro com dataInicio <= hoje <= dataFim. Sem registro = sem plano.
model BrasilSolarMonitoringPlan {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  dataInicio  DateTime @map("data_inicio")
  dataFim     DateTime @map("data_fim")
  valorMensal Float?   @map("valor_mensal")
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client BrasilSolarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, dataFim])
  @@map("brasil_solar_monitoring_plans")
}

// Pares chave/valor pra parâmetros editáveis em /admin/personalizacoes.
// Genérico de propósito — uma key por parâmetro (ex.:
// "relatorio.reajusteTarifaAnual", "relatorio.depreciacaoModuloAnual").
// Valor sempre serializado como string; helpers convertem pra número/json.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Sample do inversor a cada 30 min, coletado via Sungrow
// (getDevicePointMinuteDataList). Cobre 5h–21h BRT (32 amostras/dia).
// p1Wh = energia diária acumulada (zera 00h UTC); p2Wh = lifetime (não zera).
model InverterSample {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  psKey     String   @map("ps_key") // identificador do inversor no Sungrow
  timeStamp DateTime @map("time_stamp") // UTC
  p1Wh      Float?   @map("p1_wh") // energia diária acumulada (Wh) — zera 00h UTC
  p2Wh      Float?   @map("p2_wh") // energia lifetime acumulada (Wh)
  // Potência AC ativa em Watts no instante (soma p14+p24 do payload Sungrow).
  // Sinal limpo de geração — vira null quando inversor desliga.
  pAcW      Float?   @map("p_ac_w")
  createdAt DateTime @default(now()) @map("created_at")

  client BrasilSolarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([psKey, timeStamp])
  @@index([clientId, timeStamp])
  @@map("inverter_samples")
}

model BrasilSolarProprietario {
  id String @id @default(cuid())

  nome     String
  cpfCnpj  String? @map("cpf_cnpj")
  email    String?
  telefone String?
  endereco String?
  cidade   String?
  uf       String?

  // Dados técnicos extraídos do Anexo F (CPFL/RGE). Ficam no proprietário
  // porque a usina em si é sincronizada por API (Fronius/SolarEdge/...) e
  // depois vinculada manualmente — mas os dados do PDF precisam persistir
  // e ficar visíveis aqui.
  latitude           Float?
  longitude          Float?
  codigoUc           String? @map("codigo_uc")
  // Código de instalação ANTERIOR à migração de códigos da RGE (jul/2026).
  codigoUcAntigo     String? @map("codigo_uc_antigo")
  concessionaria     String?
  potenciaInstalada  Float?  @map("potencia_instalada")
  modulosMarca       String? @map("modulos_marca")
  modulosModelo      String? @map("modulos_modelo")
  modulosQuantidade  Int?    @map("modulos_quantidade")
  inversorMarca      String? @map("inversor_marca")
  inversorModelo     String? @map("inversor_modelo")
  inversorQuantidade Int?    @map("inversor_quantidade")
  inversorPotencia   Float?  @map("inversor_potencia")
  numeroFases        String? @map("numero_fases")
  tipoAtendimento    String? @map("tipo_atendimento")

  // Quem executa a obra: BRASIL_SOLAR (fluxo completo de obra) ou TERCEIRO
  // (Brasil Solar só monitora a geração e gere os créditos — não cria obra
  // nem tarefas automáticas).
  executadoPor String @default("BRASIL_SOLAR") @map("executado_por")

  // QUAL empresa executou, quando executadoPor=TERCEIRO. Só faz sentido nesse
  // caso; fica null para BRASIL_SOLAR. É referência a uma lista reutilizável
  // (ver EmpresaTerceira) e não texto livre — a mesma empresa digitada à mão
  // vira 5 grafias e nenhum filtro funciona depois.
  empresaTerceiraId String?          @map("empresa_terceira_id")
  empresaTerceira   EmpresaTerceira? @relation(fields: [empresaTerceiraId], references: [id], onDelete: SetNull)

  // Obra da Brasil Solar que JÁ foi executada antes do cadastro entrar no
  // sistema. Não cria Obra nem tarefas — não faz sentido agendar o que já
  // aconteceu. Diferente de executadoPor=TERCEIRO: aqui a Brasil Solar fez a
  // obra, só não há cronograma a acompanhar.
  obraJaExecutada Boolean @default(false) @map("obra_ja_executada")

  // Dados de gestão do contrato/obra. Coletados na criação do proprietário
  // quando executadoPor=BRASIL_SOLAR (obrigatórios via API nesse caso).
  // Sempre nullable no banco — TERCEIRO não preenche e o histórico anterior
  // à migração também pode estar vazio.
  // tipoTelhado: lista canônica em src/lib/tipos-telhado.ts —
  // TELHADO_METALICO | CERAMICO_CONCRETO | FIBROCIMENTO | CALHETAO_METALICO |
  // CALHETAO_FIBROCIMENTO | LAJE | ESTRUTURA_SOLO | ESTRUTURA_ESTACIONAMENTO |
  // PERSONALIZADA_MISTA. Códigos antigos (CERAMICO, CARPORT, USINA_DE_SOLO,
  // MISTO) migrados em 2026-08-02.
  // tipoTelhado LEGADO: FIBROCIMENTO | CERAMICO | LAJE | CARPORT | USINA_DE_SOLO |
  //              CALHETAO_FIBROCIMENTO | CALHETAO_METALICO | MISTO
  // tipoTelhadoOutro: descrição livre quando tipoTelhado = MISTO
  tipoTelhado       String?   @map("tipo_telhado")
  tipoTelhadoOutro  String?   @map("tipo_telhado_outro")
  dataPagamento     DateTime? @map("data_pagamento")
  prazoContratoDias Int?      @map("prazo_contrato_dias")

  observacoes String?

  // Vínculo com o usuário Clerk criado quando o proprietário aceita o convite
  // e cadastra login/senha. Preenchido no fim do fluxo de acesso pago. Um
  // usuário Clerk = um proprietário (portal do cliente Brasil Solar).
  clerkUserId String? @unique @map("clerk_user_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Um proprietario pode ter varias usinas (plantas)
  plantas BrasilSolarClient[]

  // UCs do mesmo titular que recebem créditos das usinas dele (autoconsumo
  // remoto). Modelo simples, sem versionamento — edição reescreve em vigor.
  beneficiarias BrasilSolarBeneficiaria[]

  // Acesso pago ao portal do cliente (1:1). Ver BrasilSolarAcesso.
  acesso BrasilSolarAcesso?

  // Celulares que autorizaram notificação push no portal (1 linha por aparelho).
  pushSubscriptions PushSubscription[]

  // Campanhas de mensagens que chegaram a este cliente (caixa de avisos).
  campanhaEnvios CampanhaEnvio[]

  @@index([nome])
  @@index([cpfCnpj])
  @@index([codigoUc])
  @@index([empresaTerceiraId])
  @@map("brasil_solar_proprietarios")
}

/// Empresa que NÃO é a Brasil Solar e executou o sistema do cliente
/// (`BrasilSolarProprietario.executadoPor = TERCEIRO`).
///
/// Guarda **só o nome**, de propósito: o objetivo é poder ESCOLHER de uma lista
/// em vez de digitar, para a mesma empresa não virar várias grafias e quebrar
/// filtro e agrupamento depois. Contato/CNPJ ficaram de fora a pedido do Paulo
/// (07/08/2026) — se um dia precisar, é só acrescentar coluna nullable.
///
/// `nome` é único por `nomeNormalizado` (minúsculo, sem acento) e não pelo nome
/// cru: "Solar Sul" e "SOLAR SUL" são a mesma empresa, e é justamente o que se
/// quer evitar duplicar.
model EmpresaTerceira {
  id String @id @default(cuid())

  /// Nome como o operador digitou — é o que aparece na tela.
  nome String
  /// Chave de deduplicação: `nome` em minúsculas e sem acento.
  nomeNormalizado String @unique @map("nome_normalizado")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proprietarios BrasilSolarProprietario[]

  @@index([nome])
  @@map("empresas_terceiras")
}

// Acesso pago do proprietário ao portal do cliente Brasil Solar. UM registro
// por proprietário (o acesso cobre TODAS as usinas dele). Máquina de estados:
//   AGUARDANDO_PAGAMENTO → (webhook Asaas confirma) → ATIVO
//   ATIVO → (assinatura falha / anual vence) → SUSPENSO
//   qualquer → CANCELADO (admin)
// Modalidade define como o Asaas cobra:
//   ANUAL  = cobrança única (asaasChargeId), acesso vale 12 meses (vigenteAte)
//   MENSAL = assinatura recorrente (asaasSubscriptionId), vigenteAte estende a
//            cada pagamento confirmado.
model BrasilSolarAcesso {
  id             String @id @default(cuid())
  proprietarioId String @unique @map("proprietario_id")

  modalidade String // MENSAL | ANUAL | CORTESIA
  valor      Float // R$ do plano (mensal ou anual, conforme modalidade). CORTESIA = 0.
  status     String @default("AGUARDANDO_PAGAMENTO") // AGUARDANDO_PAGAMENTO | ATIVO | SUSPENSO | CANCELADO

  // Referências no Asaas
  asaasCustomerId     String? @map("asaas_customer_id")
  asaasChargeId       String? @map("asaas_charge_id") // cobrança única (ANUAL)
  asaasSubscriptionId String? @map("asaas_subscription_id") // assinatura (MENSAL)
  checkoutUrl         String? @map("checkout_url") // invoiceUrl hospedada do Asaas

  // Token do link de cadastro (login/senha) enviado após o pagamento confirmar.
  conviteToken String? @unique @map("convite_token")

  // Vigência do acesso: liberado enquanto vigenteDesde <= hoje <= vigenteAte.
  // vigenteDesde é usado principalmente na CORTESIA (admin escolhe início e fim);
  // nas modalidades pagas fica null e a vigência é derivada do pagamento.
  vigenteDesde DateTime? @map("vigente_desde")
  vigenteAte   DateTime? @map("vigente_ate")

  conviteEnviadoEm DateTime? @map("convite_enviado_em")
  pagoEm           DateTime? @map("pago_em")
  ativadoEm        DateTime? @map("ativado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proprietario BrasilSolarProprietario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([asaasChargeId])
  @@index([asaasSubscriptionId])
  @@map("brasil_solar_acessos")
}

/// Inscrição de notificação push (Web Push) de UM aparelho do cliente.
///
/// É por APARELHO, não por pessoa: o mesmo cliente que abre o portal no celular
/// e no tablet gera duas linhas. Quem envia dispara para todas as inscrições do
/// proprietário.
///
/// `endpoint` é a URL que o navegador entrega na inscrição (FCM no Android,
/// Apple Push no iPhone) e já identifica o aparelho de forma única — por isso é
/// `@unique` e serve de chave do upsert: reautorizar no mesmo celular atualiza a
/// linha em vez de criar outra.
///
/// ⚠️ Inscrição EXPIRA sozinha (app desinstalado, permissão revogada, celular
/// trocado). O envio responde 404/410 nesses casos e o remetente APAGA a linha —
/// sem isso a tabela acumula endpoints mortos e todo disparo vira uma lista de
/// erros que ninguém lê. Ver `src/lib/push-notificacoes.ts`.
model PushSubscription {
  id             String @id @default(cuid())
  proprietarioId String @map("proprietario_id")

  /// URL do serviço de push do fabricante. Identifica o aparelho.
  endpoint String @unique
  /// Chaves de criptografia da inscrição — o payload é cifrado com elas, e nem
  /// o Google nem a Apple conseguem ler o conteúdo da notificação.
  p256dh   String
  auth     String

  /// User agent de quem autorizou, só para o operador reconhecer o aparelho na
  /// tela ("Android · Chrome"). Não é usado em nenhuma decisão.
  userAgent String? @map("user_agent")

  /// Último envio ACEITO pelo serviço de push. Aceito ≠ exibido: o aparelho
  /// desligado recebe depois, e o cliente pode ter silenciado. Serve para o
  /// operador saber que a inscrição ainda respondia naquela data.
  ultimoEnvioEm DateTime? @map("ultimo_envio_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proprietario BrasilSolarProprietario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)

  @@index([proprietarioId])
  @@map("push_subscriptions")
}

// Rateio simplificado para clientes Brasil Solar (sem versionamento, ao
// contrário de RateioVersion que é exclusivo do fluxo de investidor).
// Cada linha representa uma UC do mesmo titular recebendo créditos.
model BrasilSolarBeneficiaria {
  id             String @id @default(cuid())
  proprietarioId String @map("proprietario_id")

  codigoUc    String  @map("codigo_uc")
  // Código de instalação ANTERIOR à migração de códigos da RGE (jul/2026).
  codigoUcAntigo String? @map("codigo_uc_antigo")
  nome        String?
  percentual  Float
  observacoes String?

  // UC física vinculada — guarda as faturas baixadas. Preenchida pelo PUT bulk
  // que cria/linka uma ConsumerUnit por código de beneficiária.
  consumerUnitId String? @map("consumer_unit_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proprietario BrasilSolarProprietario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  consumerUnit ConsumerUnit?           @relation(fields: [consumerUnitId], references: [id], onDelete: SetNull)

  @@unique([proprietarioId, codigoUc])
  @@index([proprietarioId])
  @@index([codigoUc])
  @@index([consumerUnitId])
  @@map("brasil_solar_beneficiarias")
}

model MonitoringLog {
  id       String @id @default(cuid())
  clientId String @map("client_id")

  data            DateTime // Data da leitura
  geracaoDiaria   Float    @map("geracao_diaria") // kWh gerado no dia
  geracaoEsperada Float?   @map("geracao_esperada") // kWh esperado no dia
  picoMaximo      Float?   @map("pico_maximo") // kW pico do dia
  horasSol        Float?   @map("horas_sol") // Horas de sol equivalente
  irradiacao      Float? // kWh/m2 irradiacao solar
  temperatura     Float? // Temperatura media inversores

  // API    = medido, veio da plataforma de monitoramento.
  // MANUAL = rateio de um total mensal digitado por um operador, enquanto a
  //          integração da plataforma não existe (ver ManualGenerationEntry).
  // Dado real vence: todo sync grava origem=API por cima de linha MANUAL.
  // Quem exibe geração PRECISA sinalizar o que é MANUAL — estimativa não pode
  // se passar por medição.
  origem String @default("API")

  createdAt DateTime @default(now()) @map("created_at")

  client BrasilSolarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, data])
  @@index([data])
  // Sem @@index([clientId, data]): o @@unique acima JA cria um btree nas mesmas
  // colunas, na mesma ordem, e serve toda query que o indice serviria. O
  // duplicado custava 41 MB com idx_scan = 0 e foi dropado em 18/08/26.
  @@map("monitoring_logs")
}

/// Total de geração de UM PERÍODO informado à mão, para usina cuja plataforma de
/// monitoramento ainda não integra (ou parou de enviar). É registro de auditoria:
/// guarda o que o operador declarou, de onde tirou o número e quem lançou.
///
/// O dado que os relatórios leem NÃO é este — o total é rateado em linhas
/// diárias de MonitoringLog com origem=MANUAL, porque é de lá que relatório BS,
/// portal do cliente e análise de créditos somam geração. Excluir o lançamento
/// apaga as linhas rateadas.
model ManualGenerationEntry {
  id       String @id @default(cuid())
  clientId String @map("client_id")

  /// MENSAL = mês calendário fechado. PERSONALIZADO = ciclo de leitura da
  /// fatura (ex.: 10/04 a 11/05). Só muda como a janela foi escolhida na tela;
  /// o rateio é o mesmo.
  tipoPeriodo String @default("MENSAL") @map("tipo_periodo")

  /// Janela [dataInicio, dataFim) — FIM EXCLUSIVO, igual à janela de leitura
  /// usada pelo relatório (`gte dataLeituraAnterior, lt dataLeituraAtual`).
  /// Assim ciclos consecutivos (10/04–11/05, 11/05–10/06) não dividem nem
  /// duplicam o dia da virada, e o total do ciclo casa com o do relatório.
  dataInicio DateTime @map("data_inicio")
  dataFim    DateTime @map("data_fim")

  /// Competência só pra rótulo/agrupamento: no MENSAL é o próprio mês; no
  /// PERSONALIZADO é o mês do ÚLTIMO dia coberto (mesma referência da fatura).
  ano Int
  mes Int // 1-12

  kwhTotal     Float @map("kwh_total") // total do período declarado pelo operador
  kwhRateado   Float @map("kwh_rateado") // o que virou linha MANUAL (desconta dias já medidos)
  diasRateados Int   @map("dias_rateados")

  fonte      String? // de onde veio o número: print do app, cliente, foto do inversor
  observacao String?

  registradoPor String   @map("registrado_por") // email do operador
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client BrasilSolarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Janelas sobrepostas dobrariam o kWh do mesmo dia — o unique pega o caso
  // idêntico e `lancarGeracaoManual` recusa qualquer interseção parcial.
  @@unique([clientId, dataInicio, dataFim])
  @@index([clientId, dataInicio])
  @@index([ano, mes])
  @@map("manual_generation_entries")
}

model MonitoringAlert {
  id       String @id @default(cuid())
  clientId String @map("client_id")

  // Tipo e severidade
  tipo       String // OFFLINE, BAIXA_GERACAO, ERRO_INVERSOR, CONSUMO_ELEVADO, FATURA_IRREGULAR, MANUTENCAO
  severidade String  @default("MEDIA") // BAIXA, MEDIA, ALTA, CRITICA
  titulo     String
  descricao  String?

  // Status do alerta
  status String @default("ABERTO") // ABERTO, EM_ANDAMENTO, RESOLVIDO, IGNORADO

  // Resolucao
  resolvidoPor        String?   @map("resolvido_por")
  resolvidoEm         DateTime? @map("resolvido_em")
  observacaoResolucao String?   @map("observacao_resolucao")

  // Notificacoes
  notificadoCliente    Boolean @default(false) @map("notificado_cliente")
  notificadoEngenharia Boolean @default(false) @map("notificado_engenharia")

  // Ação requerida sugerida pro time de engenharia/pós-venda.
  // Valores: IR_EM_CAMPO, VERIFICAR_REMOTO, CONTATAR_CLIENTE, CONTATAR_CONCESSIONARIA, MONITORAR.
  // Default aplicado a partir do tipo na criação (ver lib/alertas-usinas.ts:getAcaoRequeridaDefault).
  acaoRequerida String? @map("acao_requerida")

  // Código de erro reportado pelo inversor (ex.: Fronius 103, SolarEdge 0x3A).
  // Operador digita manualmente; sistema busca em InverterErrorCode pra mostrar
  // título + ações sugeridas. Fabricante é inferido a partir do client.inversorMarca
  // ou client.plataformaMonitoramento na hora do lookup.
  codigoErroFabricante String? @map("codigo_erro_fabricante")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client BrasilSolarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tipo])
  @@index([severidade])
  @@index([acaoRequerida])
  @@index([clientId, status])
  @@index([createdAt])
  @@map("monitoring_alerts")
}

// Configuração global de thresholds para detecção de alertas em usinas.
// Um registro por tipo (BAIXA_GERACAO, OFFLINE, TENSAO_FORA). Editável em
// /admin/personalizacoes/alertas-usinas. Lida pela rota sync/alerts.
model AlertaThreshold {
  id String @id @default(cuid())

  // BAIXA_GERACAO | OFFLINE | TENSAO_FORA
  tipo    String  @unique
  enabled Boolean @default(true)

  // Para alertas percentuais (BAIXA_GERACAO usa PR%, TENSAO_FORA usa desvio%).
  // Convenção: thresholdCritico sempre é o limite mais severo.
  thresholdCritico Float? @map("threshold_critico")
  thresholdMedio   Float? @map("threshold_medio")
  thresholdBaixo   Float? @map("threshold_baixo")

  // Para alertas binários (OFFLINE): BAIXA | MEDIA | ALTA | CRITICA
  severidadeDefault String? @map("severidade_default")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("alerta_thresholds")
}

// Base de conhecimento de códigos de erro por fabricante de inversor.
// Cada código tem N ações sugeridas em ordem (ver InverterErrorAction).
// Editável em /admin/personalizacoes/codigos-erro-inversor.
model InverterErrorCode {
  id         String  @id @default(cuid())
  fabricante String // FRONIUS | SOLAREDGE | SUNGROW | HUAWEI
  codigo     String // ex.: "103", "0x3A", "STATE_103"
  titulo     String
  descricao  String?

  // Severidade sugerida (BAIXA | MEDIA | ALTA | CRITICA). Operador pode sobrescrever no alerta.
  severidadeSugerida String? @map("severidade_sugerida")

  acoes InverterErrorAction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fabricante, codigo])
  @@index([fabricante])
  @@map("inverter_error_codes")
}

model InverterErrorAction {
  id          String @id @default(cuid())
  errorCodeId String @map("error_code_id")
  ordem       Int
  descricao   String

  // Etiqueta de classificação: IR_EM_CAMPO | VERIFICAR_REMOTO | CONTATAR_CLIENTE | CONTATAR_CONCESSIONARIA | MONITORAR.
  acaoRequerida String? @map("acao_requerida")

  errorCode InverterErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)

  @@unique([errorCodeId, ordem])
  @@index([errorCodeId])
  @@map("inverter_error_actions")
}

// ============================================================
// CRONOGRAMA DE OBRAS - Gantt com dependências
// ============================================================

model Obra {
  id          String  @id @default(cuid())
  nome        String
  descricao   String?
  responsavel String?
  cliente     String?
  local       String?

  // Status geral da obra
  // PLANEJAMENTO | EM_EXECUCAO | PAUSADA | CONCLUIDA | CANCELADA
  status String @default("PLANEJAMENTO")

  // Aprovação do gestor antes de entrar no cronograma
  // PENDENTE | ACEITA | RECUSADA
  aprovacao String @default("PENDENTE")

  // Datas consolidadas (derivadas das tarefas, mas armazenadas para query rápida)
  dataInicioPrevista DateTime? @map("data_inicio_prevista")
  dataFimPrevista    DateTime? @map("data_fim_prevista")
  dataInicioReal     DateTime? @map("data_inicio_real")
  dataFimReal        DateTime? @map("data_fim_real")

  // Progresso 0-100 (média ponderada das tarefas)
  progresso Float @default(0)

  // Vínculo opcional com Plant (usina) ou BrasilSolarClient
  plantId                   String? @map("plant_id")
  brasilSolarClientId       String? @map("brasil_solar_client_id")
  brasilSolarProprietarioId String? @map("brasil_solar_proprietario_id")

  // Equipe de execução designada (opcional). Validação de sobreposição
  // de datas é feita por equipe — duas obras da mesma equipe não podem
  // ter intervalos que se toquem.
  equipeId String? @map("equipe_id")

  // BAIXA | MEDIA | ALTA | URGENTE
  prioridade String @default("MEDIA")

  observacoes String?

  // Marcos de geração de PDFs (ficam preenchidos a cada geração —
  // o gestao-obra usa estes para pintar os ícones de verde)
  documentoPdfGeradoEm   DateTime? @map("documento_pdf_gerado_em")
  conferenciaPdfGeradoEm DateTime? @map("conferencia_pdf_gerado_em")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tarefas       ObraTarefa[]
  listaMaterial ObraListaMaterial?
  equipe        EquipeExecucao?    @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([aprovacao])
  @@index([dataInicioPrevista])
  @@index([plantId])
  @@index([brasilSolarProprietarioId])
  @@index([equipeId])
  @@map("obras")
}

// Lista de Materiais editável por obra. Pré-preenchida pelo template fixo
// (Rede Brasil Solar) na primeira abertura; persiste edições do usuário e
// mantém referência ao último PDF gerado.
model ObraListaMaterial {
  id                  String  @id @default(cuid())
  obraId              String  @unique @map("obra_id")
  responsavel         String?
  numeroSerieInversor String? @map("numero_serie_inversor")
  observacoes         String?

  // Ciclo de vida da lista:
  // RASCUNHO  → em montagem; o gestor de obras só lê, não separa.
  // LIBERADA  → "Gerar Lista" foi clicado; o bloco de separação/retirada abre.
  // RETIRADA  → retirada fechada e assinada; comprovante emitido, tudo travado.
  status String @default("RASCUNHO")

  liberadaEm       DateTime? @map("liberada_em")
  liberadaPorId    String?   @map("liberada_por_id")
  liberadaPorNome  String?   @map("liberada_por_nome")

  // Último PDF gerado a partir desta lista
  pdfRelativePath String?   @map("pdf_relative_path")
  pdfUploadId     String?   @map("pdf_upload_id")
  pdfGeradoEm     DateTime? @map("pdf_gerado_em")

  // ----- Retirada do material pela equipe de instalação --------------------
  // Empresa/equipe que veio buscar o material (cadastro Personalizações > Equipes)
  equipeRetiradaId String? @map("equipe_retirada_id")
  // Nome digitado de quem fisicamente retirou (pode não ser o responsável da equipe)
  retiradoPor      String? @map("retirado_por")

  // Assinaturas a mão livre (PNG data URL desenhado no canvas da tela)
  assinaturaEntregouNome String? @map("assinatura_entregou_nome")
  assinaturaEntregouData String? @map("assinatura_entregou_data")
  assinaturaRetirouNome  String? @map("assinatura_retirou_nome")
  assinaturaRetirouData  String? @map("assinatura_retirou_data")

  observacoesSeparacao String?   @map("observacoes_separacao")
  retiradaEm           DateTime? @map("retirada_em")

  // Comprovante de retirada assinado (2º PDF, emitido ao fechar a retirada)
  comprovanteRelativePath String?   @map("comprovante_relative_path")
  comprovanteUploadId     String?   @map("comprovante_upload_id")
  comprovanteGeradoEm     DateTime? @map("comprovante_gerado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  obra          Obra                    @relation(fields: [obraId], references: [id], onDelete: Cascade)
  itens         ObraListaMaterialItem[]
  fotos         ObraListaMaterialFoto[]
  equipeRetirada EquipeExecucao?        @relation(fields: [equipeRetiradaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([equipeRetiradaId])
  @@map("obra_lista_materiais")
}

model ObraListaMaterialItem {
  id      String @id @default(cuid())
  listaId String @map("lista_id")

  // Agrupamento no PDF/UI: INVERSOR | ELETRICO | ESTRUTURA | FIXACAO | AVISOS
  categoria     String
  descricao     String
  especificacao String?
  quantidade    String
  ordem         Int     @default(0)

  // Preenchidos pelo gestor de obras na separação (só depois de LIBERADA).
  // quantidadeSeparada fica null enquanto ninguém editar — aí vale `quantidade`.
  separado           Boolean @default(false)
  quantidadeSeparada String? @map("quantidade_separada")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lista ObraListaMaterial @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@index([listaId, ordem])
  @@map("obra_lista_material_itens")
}

// Fotos dos materiais separados, anexadas pelo gestor de obras na retirada.
model ObraListaMaterialFoto {
  id      String @id @default(cuid())
  listaId String @map("lista_id")

  relativePath String  @map("relative_path")
  fileName     String  @map("file_name")
  mimeType     String? @map("mime_type")
  fileSize     Int?    @map("file_size")
  uploadId     String? @map("upload_id")
  legenda      String?

  createdAt DateTime @default(now()) @map("created_at")

  lista ObraListaMaterial @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@index([listaId])
  @@map("obra_lista_material_fotos")
}

model ObraTarefa {
  id     String @id @default(cuid())
  obraId String @map("obra_id")

  nome      String
  descricao String?
  ordem     Int     @default(0)

  // Planejamento
  dataInicioPlan DateTime @map("data_inicio_plan")
  dataFimPlan    DateTime @map("data_fim_plan")
  duracaoDias    Int      @map("duracao_dias") // duração em dias úteis

  // Execução real
  dataInicioReal DateTime? @map("data_inicio_real")
  dataFimReal    DateTime? @map("data_fim_real")

  // Progresso 0-100
  progresso Float @default(0)

  // Status da tarefa
  // NAO_INICIADA | EM_EXECUCAO | PAUSADA | CONCLUIDA | ATRASADA
  status String @default("NAO_INICIADA")

  responsavel String?
  cor         String? // cor da barra no Gantt (hex)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  obra         Obra                @relation(fields: [obraId], references: [id], onDelete: Cascade)
  dependencias TarefaDependencia[] @relation("TarefaSucessora") // esta tarefa depende de quais
  dependentes  TarefaDependencia[] @relation("TarefaPredecessora") // quem depende desta tarefa

  @@index([obraId])
  @@index([obraId, ordem])
  @@map("obra_tarefas")
}

model TarefaDependencia {
  id          String @id @default(cuid())
  tarefaId    String @map("tarefa_id") // tarefa sucessora (depende de)
  dependeDeId String @map("depende_de_id") // tarefa predecessora

  // Tipo de dependência:
  // FS = Finish-to-Start (padrão): predecessora precisa terminar antes da sucessora começar
  // SS = Start-to-Start: ambas começam juntas
  // FF = Finish-to-Finish: ambas terminam juntas
  // SF = Start-to-Finish: sucessora termina quando predecessora começa
  tipo String @default("FS")

  // Lag em dias (pode ser negativo para antecipar)
  lagDias Int @default(0) @map("lag_dias")

  createdAt DateTime @default(now()) @map("created_at")

  tarefa    ObraTarefa @relation("TarefaSucessora", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDe ObraTarefa @relation("TarefaPredecessora", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, dependeDeId])
  @@index([tarefaId])
  @@index([dependeDeId])
  @@map("tarefa_dependencias")
}

// Tabela de materiais padrão por potência de inversor.
// Usada na aba Personalizações > Obras para centralizar o dimensionamento
// de disjuntor, cabo, CD, DPS, barramento, canaleta, caixa e placas
// conforme a planilha "LISTA DE MATERIAIS PARA OBRAS".
// Equipe de execução (instaladores) — lista em Personalizações >
// Equipes. Usada para selecionar responsável ao programar uma obra.
model EquipeExecucao {
  id                  String  @id @default(cuid())
  nome                String  @unique
  telefoneResponsavel String? @map("telefone_responsavel")
  cor                 String? // hex color (#RRGGBB) usada no cronograma
  active              Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  obras           Obra[]
  listasRetirada  ObraListaMaterial[]

  @@index([active])
  @@map("equipes_execucao")
}

model ObraMaterialPadrao {
  id                String  @id @default(cuid())
  potenciaW         Int     @unique @map("potencia_w")
  disjuntorA        Int?    @map("disjuntor_a")
  caboMm2           Float?  @map("cabo_mm2")
  cdPosicoes        String? @map("cd_posicoes")
  dpsQtd            Int?    @map("dps_qtd")
  barramento        String?
  canaleta          String?
  caixaPassagem     String? @map("caixa_passagem")
  placaRge          Int?    @map("placa_rge")
  placaPisarModulos Int?    @map("placa_pisar_modulos")
  placaGerador      Int?    @map("placa_gerador")
  observacoes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([potenciaW])
  @@map("obra_materiais_padrao")
}

// ============================================================
// EMAILS DAS CONCESSIONÁRIAS — cadastro do destino (setor de GD)
// e do remetente autorizado, usado no envio de rateio por email.
// ============================================================
model DistribuidoraEmail {
  id              String  @id @default(cuid())
  distribuidora   String  @unique // ex: RGE, CPFL_PAULISTA, CEEE_EQUATORIAL
  emailDestino    String  @map("email_destino") // setor de GD da concessionária
  emailRemetente  String  @map("email_remetente") // de qual conta o sistema dispara
  emailCc         String? @map("email_cc") // múltiplos separados por ;
  nomeResponsavel String? @map("nome_responsavel") // responsável nosso pelo envio
  observacoes     String?
  active          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("distribuidora_emails")
}

// ============================================================
// RATEIO DE CRÉDITOS — % por UC por usina, com versionamento
// ============================================================
// Uma Plant tem 1 rateio VIGENTE por vez. Ao propor um novo, ele nasce
// PENDENTE_ACEITE e o anterior continua VIGENTE até a concessionária
// aceitar (daí o antigo vira SUBSTITUIDO e o novo vira VIGENTE). Se for
// rejeitado, vira REJEITADO e o anterior permanece valendo.
model RateioVersion {
  id               String    @id @default(cuid())
  plantId          String    @map("plant_id")
  status           String    @default("PENDENTE_ACEITE") // VIGENTE | PENDENTE_ACEITE | REJEITADO | SUBSTITUIDO
  observacao       String?
  // Nº de protocolo devolvido pela concessionária quando o rateio é registrado
  // no portal dela. Obrigatório na criação pela tela (22/08/2026); nullable no
  // banco porque os rateios anteriores a essa data nasceram sem ele.
  protocolo        String?
  // Primeiro mês de referência em que este rateio passa a valer (compara com ConsumerBill.mesReferencia/anoReferencia).
  // Permite criar rateios retroativos e agendar entrada em vigor no futuro.
  vigenteAPartirDe DateTime  @default(now()) @map("vigente_a_partir_de")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  enviadoEm        DateTime? @map("enviado_em") // enviado à concessionária
  aceitoEm         DateTime? @map("aceito_em")
  rejeitadoEm      DateTime? @map("rejeitado_em")
  substituidoEm    DateTime? @map("substituido_em")
  criadoPorUserId  String?   @map("criado_por_user_id")

  plant            Plant             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  items            RateioItem[]
  investorPayables InvestorPayable[]

  @@index([plantId, status])
  @@map("rateio_versions")
}

model RateioItem {
  id             String @id @default(cuid())
  versionId      String @map("version_id")
  consumerUnitId String @map("consumer_unit_id")
  percentual     Float // 0..100 — soma dos itens da versão deve ser 100

  version      RateioVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  consumerUnit ConsumerUnit  @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)

  @@unique([versionId, consumerUnitId])
  @@index([versionId])
  @@index([consumerUnitId])
  @@map("rateio_items")
}

// Parcela a pagar ao investidor por (UC do rateio × mês de referência).
// Fluxo: AGUARDANDO_COMPENSACAO → AGUARDANDO_PAGAMENTO → DISPONIVEL → PAGO.
// Criada sob demanda quando ConsumerBill chega com energiaCompensada > 0.
// Base + ajuste preservam auditoria de intervenções manuais no fechamento.
model InvestorPayable {
  id String @id @default(cuid())

  investorId     String @map("investor_id")
  plantId        String @map("plant_id")
  consumerUnitId String @map("consumer_unit_id")
  mesReferencia  Int    @map("mes_referencia")
  anoReferencia  Int    @map("ano_referencia")

  // 0 = cobrança única ou parcela 1 de N. Para parcelamento, gera N payables
  // (parcelaIndex 0..N-1), cada um com valorBruto/Liquido = total/N. Cada parcela
  // paga libera independentemente seu próprio payable.
  parcelaIndex Int @default(0) @map("parcela_index")

  // Snapshot do contrato/rateio no momento da criação
  sharePercent     Float   @map("share_percent")
  valorKwhContrato Float   @map("valor_kwh_contrato")
  rateioVersionId  String? @map("rateio_version_id")

  // Valores (base = calculado, ajuste = intervenção manual, líquido = final)
  kwhCompensadoBase       Float   @map("kwh_compensado_base")
  kwhCompensadoAjuste     Float   @default(0) @map("kwh_compensado_ajuste")
  valorBruto              Float   @map("valor_bruto")
  valorAjuste             Float   @default(0) @map("valor_ajuste")
  // Soma das aplicações de InvestorDebit nesta payable. Reduz o valorLiquido.
  // Mantido como coluna persistida (não calculado) pra simplificar queries/settlements.
  valorAbatidoDebito      Float   @default(0) @map("valor_abatido_debito")
  // Quanto da compensação foi descartada por ultrapassar o cap acumulado
  // da injeção da usina (créditos legados não remuneráveis ao investidor).
  // > 0 dispara alerta na UI.
  kwhCreditoLegadoAbatido Float   @default(0) @map("kwh_credito_legado_abatido")
  valorLiquido            Float   @map("valor_liquido")
  motivoAjuste            String? @map("motivo_ajuste")

  // Valor EFETIVAMENTE transferido ao investidor (pode diferir de valorLiquido
  // em caso de pagamento manual fora do fluxo normal). Quando preenchido e
  // diferente de valorLiquido, a diferença gera InvestorDebit automaticamente.
  valorRealPago       Float?  @map("valor_real_pago")
  motivoValorRealPago String? @map("motivo_valor_real_pago")

  // AGUARDANDO_COMPENSACAO | AGUARDANDO_PAGAMENTO | DISPONIVEL | PAGO | EM_COBRANCA_JUDICIAL
  status String @default("AGUARDANDO_COMPENSACAO")

  // Rastreabilidade — de onde veio cada transição
  consumerBillId        String? @map("consumer_bill_id")
  consumerUnitBillingId String? @map("consumer_unit_billing_id")
  investorSettlementId  String? @map("investor_settlement_id")

  // Fatura da UC GERADORA cujo ciclo de leitura dispachou os créditos que
  // originaram este payable. (anoReferencia, mesReferencia) desta fatura é o
  // "mês de geração" e a competência correta do relatório do investidor.
  // Pode ser null pra payables antigos antes do backfill.
  originatedByPlantBillId String? @map("originated_by_plant_bill_id")

  // Marcos temporais
  compensadoEm      DateTime? @map("compensado_em")
  pagoClienteEm     DateTime? @map("pago_cliente_em")
  disponibilizadoEm DateTime? @map("disponibilizado_em")
  pagoInvestidorEm  DateTime? @map("pago_investidor_em")

  // Cobrança judicial (fora do fluxo normal)
  cobrancaJudicialEm   DateTime? @map("cobranca_judicial_em")
  cobrancaJudicialNota String?   @map("cobranca_judicial_nota")

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Saldo carregado de payable de mês anterior (operador editou o kWh do mês N
  // e o restante virou nova linha no resumo do mês N+1, e assim por diante).
  // Sempre aponta para o payable ORIGINAL (não pra cadeia intermediária), pra
  // preservar o rótulo "saldo de [mês de origem]" através de múltiplos saltos.
  carriedFromPayableId String? @map("carried_from_payable_id")

  investor              Investor                   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  plant                 Plant                      @relation(fields: [plantId], references: [id])
  consumerUnit          ConsumerUnit               @relation(fields: [consumerUnitId], references: [id])
  consumerBill          ConsumerBill?              @relation("PayablesFromConsumerBill", fields: [consumerBillId], references: [id])
  originatedByPlantBill ConsumerBill?              @relation("PayablesOriginatedByPlantBill", fields: [originatedByPlantBillId], references: [id])
  consumerUnitBilling   ConsumerUnitBilling?       @relation(fields: [consumerUnitBillingId], references: [id])
  investorSettlement    InvestorSettlement?        @relation(fields: [investorSettlementId], references: [id])
  rateioVersion         RateioVersion?             @relation(fields: [rateioVersionId], references: [id])
  debitApplications     InvestorDebitApplication[]
  debitosOriginados     InvestorDebit[]            @relation("PayableOrigemDebito")
  carriedFromPayable    InvestorPayable?           @relation("PayableSaldoCarregado", fields: [carriedFromPayableId], references: [id])
  saldosCarregados      InvestorPayable[]          @relation("PayableSaldoCarregado")

  // Permite múltiplas linhas no mesmo (inv, uc, ano, mes, parcela) desde que
  // venham de origens diferentes — natural (carriedFromPayableId NULL) + uma
  // saldo line por origem distinta.
  @@unique([investorId, consumerUnitId, anoReferencia, mesReferencia, parcelaIndex, carriedFromPayableId])
  @@index([status, anoReferencia, mesReferencia])
  @@index([investorId, status])
  @@index([plantId, anoReferencia, mesReferencia])
  @@index([originatedByPlantBillId])
  @@index([carriedFromPayableId])
  @@map("investor_payables")
}

// Débito do investidor com a empresa — tipicamente pagamento a maior
// que foi feito no passado e precisa ser amortizado nos próximos repasses.
// valorRestante começa = valorOriginal e é decrementado a cada aplicação
// em uma InvestorPayable até chegar a 0 (status = QUITADO).
model InvestorDebit {
  id              String    @id @default(cuid())
  investorId      String    @map("investor_id")
  valorOriginal   Float     @map("valor_original")
  valorRestante   Float     @map("valor_restante")
  motivo          String?
  // Payable que originou o débito (quando foi criado automaticamente por
  // markInvestorPayableAsPaid ao detectar valorRealPago > valorLiquido).
  // NULL = débito registrado manualmente.
  payableOrigemId String?   @map("payable_origem_id")
  // ABERTO | QUITADO | CANCELADO
  status          String    @default("ABERTO")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  quitadoEm       DateTime? @map("quitado_em")
  canceladoEm     DateTime? @map("cancelado_em")
  criadoPorUserId String?   @map("criado_por_user_id")

  investor      Investor                   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  applications  InvestorDebitApplication[]
  payableOrigem InvestorPayable?           @relation("PayableOrigemDebito", fields: [payableOrigemId], references: [id])

  @@index([investorId, status])
  @@index([payableOrigemId])
  @@map("investor_debits")
}

// Registro de uma aplicação parcial (ou total) de um débito em uma payable.
// Mantém auditoria: quanto foi abatido, quando, de qual débito, em qual payable.
// Cancelamento do débito apaga as applications e restaura o valorLiquido das payables.
model InvestorDebitApplication {
  id           String   @id @default(cuid())
  debitId      String   @map("debit_id")
  payableId    String   @map("payable_id")
  valorAbatido Float    @map("valor_abatido")
  aplicadoEm   DateTime @default(now()) @map("aplicado_em")

  debit   InvestorDebit   @relation(fields: [debitId], references: [id], onDelete: Cascade)
  payable InvestorPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@unique([debitId, payableId])
  @@index([payableId])
  @@map("investor_debit_applications")
}

// Fechamento mensal de pagamento ao investidor.
// Agrupa os InvestorPayable DISPONIVEL no momento da geração (podem ser de várias
// referências — ex.: parcela de janeiro que só foi paga pelo cliente em abril entra
// no fechamento de abril).
// Fluxo: DRAFT (job dia 20 cria) → PUBLISHED (Paulo confirma após revisar/ajustar).
model InvestorSettlement {
  id String @id @default(cuid())

  investorId    String @map("investor_id")
  anoFechamento Int    @map("ano_fechamento") // mês calendário em que o fechamento acontece (ex.: 2026/04)
  mesFechamento Int    @map("mes_fechamento")

  // DRAFT | PUBLISHED | CANCELED
  status String @default("DRAFT")

  // Snapshot dos totais (recalculado quando publica)
  totalKwh      Float @default(0) @map("total_kwh")
  totalBruto    Float @default(0) @map("total_bruto")
  totalAjuste   Float @default(0) @map("total_ajuste")
  totalLiquido  Float @default(0) @map("total_liquido")
  totalPayables Int   @default(0) @map("total_payables")

  // Linha extra do fechamento: gestão fixa mensal do contrato InvestorPlant
  gestaoFixaAplicada Float @default(0) @map("gestao_fixa_aplicada")

  // Ajustes manuais do operador no fechamento (soma livre)
  outrosAjustes Float   @default(0) @map("outros_ajustes")
  outrosNotas   String? @map("outros_notas")

  // Total que vai pro investidor (= totalLiquido − gestaoFixaAplicada + outrosAjustes)
  valorAPagar Float @default(0) @map("valor_a_pagar")

  // Marcos
  geradoEm        DateTime  @default(now()) @map("gerado_em")
  publicadoEm     DateTime? @map("publicado_em")
  pagoEm          DateTime? @map("pago_em")
  pagoComprovante String?   @map("pago_comprovante")

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  investor Investor          @relation(fields: [investorId], references: [id], onDelete: Cascade)
  payables InvestorPayable[]

  @@unique([investorId, anoFechamento, mesFechamento])
  @@index([status, anoFechamento, mesFechamento])
  @@map("investor_settlements")
}

// ============================================================
// FECHAMENTO FINANCEIRO — config
// ============================================================
// Alíquota de imposto vigente a partir de um mês. O cálculo do fechamento
// busca a TaxRate cuja vigenciaInicio é <= primeiro dia do mês referente.
model TaxRate {
  id             String   @id @default(cuid())
  // Primeiro dia do mês a partir do qual a alíquota passa a valer.
  vigenciaInicio DateTime @map("vigencia_inicio")
  // Percentual sobre receita bruta (0..100). Ex.: 6.0 = 6%.
  percentual     Float
  observacao     String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  @@unique([vigenciaInicio])
  @@map("tax_rates")
}

// Catálogo de rubricas de custos fixos (Click Sign, Contador, Folha, etc.).
// Cada rubrica tem um valor padrão que é proposto a cada novo mês;
// o gestor confirma/edita o valor efetivo na entrada do mês.
model RecurringCost {
  id           String   @id @default(cuid())
  nome         String
  // Categoria livre (texto) — agrupa no relatório. Ex.: "Folha", "Software", "Infra".
  categoria    String?
  valorPadrao  Float    @default(0) @map("valor_padrao")
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  observacao   String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  entries RecurringCostEntry[]

  @@unique([nome])
  @@index([ativo, ordem])
  @@map("recurring_costs")
}

// Valor efetivo de uma rubrica em um mês específico. Criado/atualizado quando
// o gestor confirma o valor durante o fechamento. Se não existir entry, o
// fechamento usa valorPadrao da RecurringCost.
model RecurringCostEntry {
  id                  String   @id @default(cuid())
  recurringCostId     String   @map("recurring_cost_id")
  ano                 Int
  mes                 Int
  valor               Float
  // Snapshot do valorPadrao no momento da confirmação (auditoria).
  valorPadraoNoMes    Float?   @map("valor_padrao_no_mes")
  confirmadoEm        DateTime @default(now()) @map("confirmado_em")
  confirmadoPorUserId String?  @map("confirmado_por_user_id")
  observacao          String?

  recurringCost RecurringCost @relation(fields: [recurringCostId], references: [id], onDelete: Cascade)

  @@unique([recurringCostId, ano, mes])
  @@index([ano, mes])
  @@map("recurring_cost_entries")
}

// Ação recomendada persistida — gerada pela Análise de Créditos.
// Dedup entre runs via `fingerprint` (hash determinístico de tipo+escopo+mês).
// Status existe pra fechar o ciclo operacional: o operador marca FEITA ou
// DISPENSADA; a próxima run da análise NÃO recria a mesma ação se ela já
// está nesses estados (ainda dentro da janela de validade).
model AcaoRecomendada {
  id String @id @default(cuid())

  // Hash determinístico: SHA1(tipo + plantId + consumerUnitId + mesRef + anoRef).
  // Permite que rodadas seguidas da análise upsertem a mesma ação sem duplicar.
  fingerprint String @unique

  tipo       String // AcaoTipo (CREDITOS_VENCENDO_30D, USINA_SUBPERFORMANDO, ...)
  severidade String // info | atencao | critico
  titulo     String
  descricao  String @db.Text
  prazoDias  Int    @map("prazo_dias") // 30 | 60 | 90 — janela do SLA

  plantId        String? @map("plant_id")
  consumerUnitId String? @map("consumer_unit_id")
  metricaValor   Float?  @map("metrica_valor")
  metricaLabel   String? @map("metrica_label")

  // Mês de referência em que a ação foi vista pela primeira vez. Usado pra
  // saber se a ação ainda é desse ciclo ou virou histórico de outro.
  mesReferencia Int @map("mes_referencia")
  anoReferencia Int @map("ano_referencia")

  // ABERTA | FEITA | DISPENSADA | AUTO_FECHADA (sumiu naturalmente da análise)
  status String @default("ABERTA")

  // Prazo calculado na criação (criadaEm + prazoDias). Usado pra ordenar
  // por urgência e calcular "atrasada".
  prazoEm DateTime @map("prazo_em")

  responsavelUserId   String?   @map("responsavel_user_id")
  observacaoResolucao String?   @map("observacao_resolucao") @db.Text
  resolvidaEm         DateTime? @map("resolvida_em")
  resolvidaPorUserId  String?   @map("resolvida_por_user_id")

  criadaEm     DateTime @default(now()) @map("criada_em")
  atualizadaEm DateTime @updatedAt @map("atualizada_em")
  // Última vez que a análise viu essa ação ainda válida. Quando uma ação
  // ABERTA não é revista por N dias, vira AUTO_FECHADA.
  vistaEm      DateTime @default(now()) @map("vista_em")

  plant        Plant?        @relation(fields: [plantId], references: [id], onDelete: SetNull)
  consumerUnit ConsumerUnit? @relation(fields: [consumerUnitId], references: [id], onDelete: SetNull)
  responsavel  User?         @relation("AcaoResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  resolvidaPor User?         @relation("AcaoResolvidaPor", fields: [resolvidaPorUserId], references: [id], onDelete: SetNull)

  @@index([status, prazoEm])
  @@index([plantId, status])
  @@index([consumerUnitId, status])
  @@index([anoReferencia, mesReferencia])
  @@map("acao_recomendada")
}

// Snapshot do payload da Análise de Créditos pra um (mes, ano, escopo).
// Gerado quando o mês fica completo (todas as UCs com fatura cadastrada).
// Source-of-truth pra históricos comparáveis, emails mensais e tendências
// que envolvem +6 meses (fora da janela do compute on-the-fly).
model AnaliseCreditosSnapshot {
  id String @id @default(cuid())

  mesReferencia Int @map("mes_referencia")
  anoReferencia Int @map("ano_referencia")

  // FULL = portfólio inteiro; PLANT = uma usina; INVESTOR = um investidor.
  // escopoId é null pra FULL.
  escopoTipo String  @map("escopo_tipo")
  escopoId   String? @map("escopo_id")

  completo Boolean @default(false)

  // JSON completo do AnaliseCreditosResult na hora do snapshot.
  // Imutável — recompute futuro NÃO sobrescreve o snapshot histórico.
  payloadJson String @map("payload_json") @db.Text

  emailEnviado       Boolean   @default(false) @map("email_enviado")
  emailEnviadoEm     DateTime? @map("email_enviado_em")
  emailDestinatarios String?   @map("email_destinatarios") // CSV de emails

  geradoEm        DateTime @default(now()) @map("gerado_em")
  geradoPorUserId String?  @map("gerado_por_user_id") // null = automático (script/cron)

  @@unique([mesReferencia, anoReferencia, escopoTipo, escopoId])
  @@index([anoReferencia, mesReferencia])
  @@map("analise_creditos_snapshot")
}

// Baseline de consumo: marca uma UC como "consumo esperadamente diferente
// da média" por uma janela de meses. A Análise de Créditos suprime ações
// CONSUMO_ANOMALO dessa UC enquanto o baseline estiver ativo.
//
// Casos típicos: UC sazonal (verão/inverno), inquilino novo, atividade
// comercial parada, troca de equipamento. Operador marca pra parar de
// receber o mesmo alerta toda análise sem perder a possibilidade de
// reinvestigar depois que o baseline expirar.
model ConsumoBaseline {
  id String @id @default(cuid())

  consumerUnitId String @map("consumer_unit_id")

  // SAZONAL | DESOCUPADA | ATIVIDADE_BAIXA | CONFIRMADO_PELO_CLIENTE | OUTRO
  motivo     String
  observacao String? @db.Text

  // Janela de validade. Quando o mês de referência ultrapassa, baseline
  // expira automaticamente (não é deletado — fica como histórico).
  validoAteMes Int @map("valido_ate_mes")
  validoAteAno Int @map("valido_ate_ano")

  criadoEm        DateTime @default(now()) @map("criado_em")
  criadoPorUserId String?  @map("criado_por_user_id")

  consumerUnit ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)

  @@index([consumerUnitId, validoAteAno, validoAteMes])
  @@map("consumo_baseline")
}

// ---------------------------------------------------------------------------
// INTEGRAÇÃO COM O CRM (GERADOR_PROPOSTA / Supabase)
//
// O CRM comercial vive em outro banco (Supabase) e continua sendo a fonte da
// venda. Aqui a gente só LÊ: um job puxa as vendas ganhas e as adesões e
// enfileira o que precisa virar obra, UC ou usina neste sistema.
//
// Por que pull e não webhook: não exige mudança no CRM (que o time comercial
// usa o dia inteiro), ganha retry e backfill de graça, e a latência de minutos
// é irrelevante — o processo hoje simplesmente não existe.
// ---------------------------------------------------------------------------

// De-para PRODUTO DO CRM → o que ele gera aqui. Editável na UI de propósito:
// o catálogo do CRM cresce (19 produtos hoje) e um produto novo NÃO pode sumir
// em silêncio — sem linha aqui, a venda cai na caixa de "não classificado".
model CrmProdutoDestino {
  id String @id @default(cuid())

  // `produtos.codigo` no CRM (ex.: solar_fotovoltaica, inspecao_completa).
  codigoProduto String @unique @map("codigo_produto")
  nomeProduto   String @map("nome_produto")

  // Gera obra na fila de aprovação do gestor de obras?
  geraObra Boolean @default(false) @map("gera_obra")
  // INSTALACAO | MANUTENCAO — só faz sentido quando geraObra = true.
  tipoObra String? @map("tipo_obra")

  // O que a venda gera na gestão, além da obra:
  // NENHUM | ADESAO (UC beneficiária + balanço de créditos)
  // | USINA_UC (cliente cede o telhado: vira usina E UC)
  // | MONITORAMENTO (plano de monitoramento pago)
  destinoGestao String @default("NENHUM") @map("destino_gestao")

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_produto_destino")
}

// Uma linha por PROPOSTA do CRM que entrou aqui. Serve de trava de
// idempotência (o job roda de hora em hora e não pode duplicar) e de fila de
// trabalho para quem cadastra UC/usina.
//
// `propostaIdCrm` é o rastro confiável de origem. O vínculo com cliente BS
// fica NULO de propósito: os 1.819 brasil_solar_clients estão sem CPF/CNPJ,
// então casar por nome geraria vínculo errado em silêncio. Quem aprova decide.
model CrmVendaImportada {
  id String @id @default(cuid())

  // Chave no CRM (propostas.id — BIGSERIAL lá, Int aqui).
  propostaIdCrm  Int     @unique @map("proposta_id_crm")
  numeroProposta String? @map("numero_proposta")

  codigoProduto String @map("codigo_produto")
  nomeProduto   String @map("nome_produto")

  clienteNome      String  @map("cliente_nome")
  clienteDocumento String? @map("cliente_documento")
  clienteIdCrm     Int?    @map("cliente_id_crm")
  cidade           String?
  vendedorEmail    String? @map("vendedor_email")
  // Nome completo, de `usuarios.nome` no CRM. O e-mail sozinho obriga quem lê
  // a traduzir "carolina@solvesm.eng.br" para uma pessoa.
  vendedorNome     String? @map("vendedor_nome")

  valorInvestimento Float?    @map("valor_investimento")
  fechadoEm         DateTime? @map("fechado_em")
  statusNegocio     String    @map("status_negocio")

  // Preenchidos quando a venda tem Termo de Adesão gerado no CRM.
  adesaoIdCrm    Int?    @map("adesao_id_crm")
  concessionaria String?
  // Códigos de UC da adesão, separados por vírgula (uma adesão pode ter
  // várias — o RESIDENCIAL MORADA DO LESTE tem 10).
  codigosUc      String? @map("codigos_uc")
  mediaMensalKwh Float?  @map("media_mensal_kwh")

  // PENDENTE            — classificada, esperando ação nesta ponta
  // CONCLUIDA           — já virou obra/UC/usina aqui
  // IGNORADA            — de-para diz que não entra no Gestor
  // NAO_CLASSIFICADO    — produto sem linha no de-para (exige decisão)
  // ASSINADA_SEM_VENDA  — tem adesão assinada mas a proposta não está "ganha"
  situacao String @default("PENDENTE")

  // Obra criada a partir desta venda, quando o produto gera obra.
  obraId     String? @map("obra_id")
  observacao String? @db.Text

  primeiraLeituraEm DateTime  @default(now()) @map("primeira_leitura_em")
  ultimaLeituraEm   DateTime  @updatedAt @map("ultima_leitura_em")
  processadaEm      DateTime? @map("processada_em")
  processadaPorId   String?   @map("processada_por_id")

  @@index([situacao])
  @@index([codigoProduto])
  @@map("crm_venda_importada")
}

/// Uma linha por UNIDADE CONSUMIDORA assinada no Termo de Adesão do CRM.
///
/// Existe porque a unidade de trabalho é a UC, não a proposta: é a UC que vai
/// ser interligada com a usina. `CrmVendaImportada` guarda uma linha por
/// proposta, e isso perdia dado calado — uma proposta pode ter VÁRIAS adesões
/// assinadas (o INSTITUTO ELEVA tem duas, a PONTELLI tem quatro), e cada
/// adesão pode ter várias UCs. Em 15/08/2026 eram 35 UCs assinadas no CRM
/// contra 30 que cabiam no modelo por proposta.
///
/// Traz junto os dados do consumidor como foram ASSINADOS, para o cadastro da
/// UC chegar pré-preenchido em vez de ser redigitado.
model CrmUcImportada {
  id String @id @default(cuid())

  // Chaves no CRM. A unicidade é (adesão, código) e não a proposta,
  // justamente porque a proposta se repete.
  propostaIdCrm Int    @map("proposta_id_crm")
  adesaoIdCrm   Int    @map("adesao_id_crm")

  // Ordem de exibição, copiada do CRM para a conferência ficar linha a linha.
  // O CRM lista adesões com `criado_em` DESCENDENTE (a mais nova primeiro) —
  // ver backend/src/routes/adesoes.js na rota GET /. Dentro de uma adesão,
  // `ordemNaAdesao` é a posição no array `unidades_consumidoras`, que é a
  // ordem em que as UCs aparecem no próprio termo assinado.
  adesaoCriadaEm DateTime? @map("adesao_criada_em")
  ordemNaAdesao  Int       @default(0) @map("ordem_na_adesao")
  // Só dígitos, para casar com ConsumerUnit.codigoUc. Ver [[whereCodigoUc]].
  codigoUc      String @map("codigo_uc")
  // Como veio do CRM ("2.715.094.001-03"), para exibir igual ao termo.
  codigoUcBruto String? @map("codigo_uc_bruto")

  // kWh/mês DESTA UC. Vem de `medias_mensais_kwh[i]`, pareado por POSIÇÃO com
  // `unidades_consumidoras[i]`. Os dois arrays batem em 23/23 adesões; quando
  // não baterem, o sync grava null em vez de parear errado.
  mediaMensalKwh Float? @map("media_mensal_kwh")

  // O que foi COMBINADO com o cliente na apresentação da proposta, copiado de
  // `propostas.dados_snapshot->dados_desconto_fatura` no CRM.
  //
  // `descontoPercent` é o DESCONTO (15 = 15% off), não a fatia cobrada — o
  // oposto de `ConsumerUnit.percentCompensado`, que guarda 0,85. A conversão
  // mora num lugar só: `descontoParaPercentCobrado()` em lib/crm-desconto.ts.
  //
  // Null = a proposta não disse. Não vira 15 em lugar nenhum: desconto
  // presumido é o que a operação precisa enxergar, não o que ela deve herdar.
  descontoPercent Float?  @map("desconto_percent")
  planoContrato   String? @map("plano_contrato")
  fidelidadeMeses Int?    @map("fidelidade_meses")

  // Quem FECHOU o negócio: o vendedor da PROPOSTA (`usuarios.nome` no CRM, que
  // já é o nome completo). É esse que a comissão segue.
  //
  // `vendedorAdesaoNome` é quem GEROU O TERMO, e só é gravado quando difere —
  // aconteceu em 2 das 22 adesões (medido 16/08/2026). Guardar os dois evita
  // escolher um em silêncio; ver [[feedback_anomalias_sinalizar]].
  vendedorNome       String? @map("vendedor_nome")
  vendedorEmail      String? @map("vendedor_email")
  vendedorAdesaoNome String? @map("vendedor_adesao_nome")

  // Consumidor, como assinado na adesão.
  clienteNome      String  @map("cliente_nome")
  clienteDocumento String? @map("cliente_documento")
  clienteTipo      String? @map("cliente_tipo")
  clienteEmail     String? @map("cliente_email")
  clienteTelefone  String? @map("cliente_telefone")

  // Endereço do titular no termo.
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?

  // Representante legal — preenchido quando o titular é PJ.
  representanteNome  String? @map("representante_nome")
  representanteCpf   String? @map("representante_cpf")
  representanteCargo String? @map("representante_cargo")

  concessionaria    String?
  proprietarioUsina Boolean @default(false) @map("proprietario_usina")

  // Assinatura do Termo (tabela `envelopes_assinatura` no CRM).
  assinaturaStatus String?   @map("assinatura_status")
  assinadoEm       DateTime? @map("assinado_em")
  envelopeIdCrm    String?   @map("envelope_id_crm")

  // PENDENTE | CONCLUIDA | IGNORADA — o cadastro é decidido por UC.
  //
  // Este campo é do OPERADOR. O sync nunca o reescreve: quem marcou como
  // cadastrada não vê o trabalho voltar numa re-sincronização.
  situacao String @default("PENDENTE")

  // Estes dois são do CRM, e por isso vivem separados de `situacao`. A venda
  // pode ter termo assinado e ainda estar em negociação — foi o caso do
  // RESIDENCIAL MORADA DO LESTE, com 10 UCs assinadas numa proposta
  // `em_negociacao`. Sem separar, essas 10 apareciam em "A cadastrar" como se
  // o negócio estivesse fechado.
  //
  // O sync atualiza os dois livremente: se a venda fechar amanhã, a UC entra
  // na fila principal sozinha, sem ninguém precisar reabrir nada.
  vendaGanha    Boolean @default(true) @map("venda_ganha")
  statusNegocio String? @map("status_negocio")

  // Preenchido quando a UC vira cadastro aqui. É o elo com a usina.
  consumerUnitId String? @map("consumer_unit_id")

  primeiraLeituraEm DateTime  @default(now()) @map("primeira_leitura_em")
  ultimaLeituraEm   DateTime  @updatedAt @map("ultima_leitura_em")
  processadaEm      DateTime? @map("processada_em")

  @@unique([adesaoIdCrm, codigoUc])
  @@index([situacao])
  @@index([propostaIdCrm])
  @@index([codigoUc])
  @@map("crm_uc_importada")
}

/// Campanha de MENSAGENS: um aviso escrito uma vez e entregue a um público de
/// clientes da Rede Brasil Solar (push no celular + caixa de avisos do portal).
///
/// É ferramenta comercial, não notificação de sistema: existe para oferecer
/// limpeza, seguro, manutenção, reconexão de wi-fi. Alerta automático de usina
/// parada continua sendo `MonitoringAlert` — são coisas diferentes e não devem
/// se misturar.
///
/// ⚠️ O texto do disparo fica CONGELADO aqui. Editar uma campanha já enviada
/// mudaria o histórico do que o cliente recebeu, então o código só deixa editar
/// enquanto está em RASCUNHO.
///
/// O público NÃO é congelado como lista de IDs no rascunho — só o filtro. A
/// lista real é resolvida no instante do disparo (e aí sim vira uma linha de
/// `CampanhaEnvio` por cliente, que é o histórico de verdade). Um filtro
/// resolvido na semana passada devolveria clientes que já saíram.
model Campanha {
  id String @id @default(cuid())

  /// Nome interno, só o operador vê na lista ("Limpeza semestral — agosto").
  nome String

  /// Título e corpo exatamente como o celular exibe.
  titulo   String
  mensagem String

  /// Tela aberta ao tocar. Default `/portal-cliente`. O disparo acrescenta
  /// `?aviso=<envioId>` para a caixa de avisos abrir já naquele item.
  urlDestino String? @map("url_destino")

  /// Rótulo do botão de interesse na caixa de avisos ("Quero um orçamento").
  /// Null = aviso sem CTA, só informativo.
  ctaLabel String? @map("cta_label")

  /// PUSH_E_PORTAL = toca o celular de quem autorizou e aparece no portal.
  /// SO_PORTAL     = só a caixa de avisos, sem tocar celular nenhum.
  canal String @default("PUSH_E_PORTAL")

  /// Filtro de público serializado. O shape vive em `mensagens-publico.ts` —
  /// Json aqui de propósito: filtro novo não pode exigir migração de banco.
  publicoFiltro Json?   @map("publico_filtro")
  /// Frase legível do filtro, congelada no disparo ("Com app · RS · ≥ 10 kWp").
  publicoResumo String? @map("publico_resumo")

  /// RASCUNHO | ENVIANDO | ENVIADA | FALHOU
  status String @default("RASCUNHO")

  /// Contadores congelados no disparo — a contagem "ao vivo" mudaria com o
  /// tempo e o relatório da campanha deixaria de bater com o que aconteceu.
  totalPublico   Int @default(0) @map("total_publico")
  totalComApp    Int @default(0) @map("total_com_app")
  totalAparelhos Int @default(0) @map("total_aparelhos")

  criadoPorId   String?   @map("criado_por_id")
  criadoPorNome String?   @map("criado_por_nome")
  enviadaEm     DateTime? @map("enviada_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  envios CampanhaEnvio[]

  @@index([status])
  @@index([createdAt])
  @@map("campanhas")
}

/// A campanha CHEGANDO em um cliente: uma linha por proprietário atingido.
///
/// Faz dois papéis de propósito, porque são o mesmo fato:
///   1. histórico do disparo (quantos aparelhos, deu erro?);
///   2. a CAIXA DE AVISOS do portal — o cliente sem celular inscrito também
///      tem sua linha e vê a mensagem quando entrar.
///
/// Push não confirma leitura (ver `push-notificacoes.ts`). Quem prova
/// engajamento é `lidoEm` (abriu no portal) e sobretudo `interesseEm`, que é o
/// lead: cliente tocou "quero" e o pós-venda tem de ligar.
model CampanhaEnvio {
  id String @id @default(cuid())

  /// EXATAMENTE UM dos dois é preenchido. `campanhaId` = divisão 1 (campanha
  /// escrita e disparada à mão); `ativacaoId` = divisão 2 (regra que disparou
  /// sozinha). A caixa de avisos do cliente é a mesma para os dois: quem recebe
  /// não distingue "campanha" de "ativação", recebe uma mensagem da empresa.
  campanhaId String? @map("campanha_id")
  ativacaoId String? @map("ativacao_id")

  proprietarioId String @map("proprietario_id")

  /// Aparelhos inscritos no instante do disparo.
  aparelhos Int @default(0)

  /// ENVIADO | SEM_APARELHO | FALHA | SO_PORTAL
  pushStatus String  @default("SEM_APARELHO") @map("push_status")
  erro       String?

  lidoEm       DateTime? @map("lido_em")
  interesseEm  DateTime? @map("interesse_em")

  /// Quem do pós-venda já falou com este cliente, e quando. Enquanto for null o
  /// lead conta no sino do AURA — é o que separa "levantou a mão" de "já foi
  /// atendido". Sem isto o aviso mostraria os mesmos leads para sempre e o time
  /// aprenderia a ignorar o sino.
  atendidoEm      DateTime? @map("atendido_em")
  atendidoPorNome String?   @map("atendido_por_nome")
  /// Cliente tocou "não tenho interesse" — some da caixa e vira sinal de que
  /// aquela oferta não colou. Não silencia campanhas futuras.
  dispensadoEm DateTime? @map("dispensado_em")

  createdAt DateTime @default(now()) @map("created_at")

  campanha     Campanha?               @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  ativacao     Ativacao?               @relation(fields: [ativacaoId], references: [id], onDelete: Cascade)
  proprietario BrasilSolarProprietario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)

  /// Vale só para campanha: ninguém recebe a MESMA campanha duas vezes. Não
  /// alcança as ativações porque no Postgres NULL nunca colide com NULL — e é
  /// isso que se quer: a mesma regra pode reencontrar o mesmo cliente meses
  /// depois, e quem controla essa repetição é o `cooldownDias`.
  @@unique([campanhaId, proprietarioId])
  @@index([ativacaoId, proprietarioId])
  @@index([proprietarioId, dispensadoEm])
  @@index([campanhaId, interesseEm])
  // O sino consulta exatamente por aqui: interesse dado e ainda sem atendimento.
  @@index([interesseEm, atendidoEm])
  @@map("campanha_envios")
}

/// ATIVAÇÃO: regra que manda a mensagem SOZINHA quando o cliente entra em uma
/// condição — a divisão 2 do módulo Mensagens.
///
/// A diferença para `Campanha` não é técnica, é de natureza: campanha é uma
/// decisão comercial tomada num dia ("vamos oferecer limpeza este mês"), e
/// ativação é uma promessa permanente ("sempre que a usina de alguém ficar
/// muda, avise a pessoa"). Uma é escrita e disparada; a outra é ligada e
/// esquecida — e é justamente por ser esquecida que precisa de trava.
///
/// 🔑 NÃO redetecta nada. Os gatilhos de inversor leem `MonitoringAlert`, que é
/// recalculado a cada 15 min com thresholds configuráveis em Personalizações.
/// Uma segunda definição de "usina parada" aqui divergiria da que o time usa,
/// e o cliente receberia aviso de um problema que a tela do operador não mostra.
///
/// ⚠️ Nasce SEMPRE desligada (`ativa = false`). Ligar é ato explícito de gente,
/// porque a partir dali a mensagem sai sem ninguém aprovar cada envio.
model Ativacao {
  id String @id @default(cuid())

  /// Nome interno ("Wi-fi caiu — avisar cliente").
  nome String

  /// Qual condição observa. Catálogo em `src/lib/mensagens-gatilhos.ts`:
  /// ALERTA_USINA | AGENDA_MENSAL | ANIVERSARIO_SISTEMA
  gatilho String
  /// Parâmetros do gatilho (tipos de alerta, dia do mês, meses…). Json de
  /// propósito: gatilho novo não pode exigir migração de banco.
  params Json?

  titulo   String
  mensagem String
  ctaLabel String? @map("cta_label")
  canal    String  @default("PUSH_E_PORTAL")

  /// Desligada até alguém ligar. Ver o aviso acima.
  ativa Boolean @default(false)

  /// Dias que o MESMO cliente fica imune a ESTA regra depois de receber. Sem
  /// isso, uma usina que passa três semanas muda geraria três semanas de aviso
  /// diário sobre a mesma coisa, e a pessoa desinstala o app.
  cooldownDias Int @default(30) @map("cooldown_dias")

  criadoPorNome String?   @map("criado_por_nome")
  /// Quando foi ligada pela última vez. Ao ligar, quem já está na condição é
  /// marcado como visto SEM receber — senão acender a regra dispararia de uma
  /// vez para todo mundo que já estava com problema há meses.
  ativadaEm         DateTime? @map("ativada_em")
  ultimaAvaliacaoEm DateTime? @map("ultima_avaliacao_em")
  totalDisparos     Int       @default(0) @map("total_disparos")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  envios CampanhaEnvio[]

  @@index([ativa])
  @@map("ativacoes")
}
